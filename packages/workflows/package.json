{
  "name": "@moysklad/workflows",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./validate": "./src/validate.ts",
    "./data-model-schema": "./src/data-model-schema.ts",
    "./data-model-validate": "./src/data-model-validate.ts"
  },
  "scripts": {
    "validate": "tsx src/cli/validate.ts",
    "validate:data-model": "tsx src/cli/validate-data-model.ts",
    "validate:all": "pnpm validate && pnpm validate:data-model",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@moysklad/config": "workspace:*",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
