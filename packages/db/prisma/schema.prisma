  // ── PARTIAL unique index (Prisma representation gap — READ before "fixing" any diff) ──
  // The real DB index is PARTIAL: `Employee_account_username_uk ON employees(account_id,
  // username) WHERE username IS NOT NULL` (created in migration 20260520095826_hr_module_
  // foundation, lines 475-481). Prisma 5.x cannot model a partial/filtered unique index,
  // so `@@unique` below regenerates a *plain* index expectation. Consequence: `prisma
  // migrate diff` PERMANENTLY emits `CREATE UNIQUE INDEX "employees_account_id_username_key"`.
  // That index is NOT missing — it exists as the partial one above and IS enforced (proven:
  // scripts/probe-employee-username-index.mts → 23505 on a duplicate non-null username).
  // DO NOT "fix" that diff by adding a plain index (would duplicate/contradict the partial
  // one). The 2026-06-12 (11s) handoff misread this diff line as "uniqueness not enforced" —
  // it is. Guard: apps/api/src/modules/hr/hr-employee/employee-username-unique-index.test.ts.
  @@unique([accountId, username], name: "Employee_account_username_uk")
  @@index([accountId, archived])
  @@index([accountId, groupId])
  @@index([accountId, departmentId])
  @@index([accountId, positionId])
  @@index([accountId, scheduleId])
  @@map("employees")
}

// Role — per-account definition (e.g. Administrator, Manager, Cashier).
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  // Is system-provisioned (cannot be deleted).
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version     Int      @default(1)

  permissions RolePermission[]
  employees   EmployeeRole[]

  @@unique([accountId, name])
  @@index([accountId])
  @@map("roles")
}

// Flat permission matrix — role × entity × action → scope.
//
// Scope enum (stored as string):
//   NO             — no access
//   OWN            — only records where owner = me
//   OWN_GROUP      — my department's records
//   OWN_AND_GROUP  — mine + department
//   ALL            — everything in tenant
model RolePermission {
  roleId String @map("role_id") @db.Uuid
  entity String @db.VarChar(50) // 'product', 'counterparty', 'productfolder', ...
  action String @db.VarChar(20) // 'view', 'create', 'update', 'delete', 'approve', 'print'
  scope  String @default("NO") @db.VarChar(20)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, entity, action])
  @@map("role_permissions")
}

// Employee ↔ Role join (many-to-many; effective permissions = UNION across roles).
model EmployeeRole {
  employeeId String   @map("employee_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([employeeId, roleId])
  @@index([employeeId])
  @@map("employee_roles")
}

// Refresh tokens — rotating, HttpOnly cookie-bound.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz()
  // Rotation lineage: familyId = the login token's own id, inherited by every
  // rotation successor; replacedById marks rotation-revocation (vs logout).
  // Together they implement the refresh-rotation grace window (cross-tab
  // refresh race) + post-grace family revocation — see apps/api
  // token.service.ts rotateRefreshToken.
  familyId     String?   @map("family_id") @db.Uuid
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, revokedAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

// API access token. Distinct from RefreshToken (which is per-browser-
// session JWT refresh) — ApiToken is for INTEGRATIONS (1C, Telegram bot,
// custom scripts) and matches moysklad's Bearer-token auth model. The
// /api/remap/1.2/* compat router accepts these.
//
// Token plaintext is shown to the user ONCE on creation; we store the
// SHA-256 hash. lastUsedAt + ipAddress are bumped on each request for
// audit + "kill stale token" UX.
model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  /// Optional employee owner — null for service tokens minted by admin.
  employeeId String?   @map("employee_id") @db.Uuid
  /// SHA-256 hex of the bearer token plaintext.
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  /// Display name for the API tokens admin page.
  name       String    @db.VarChar(255)
  /// Optional permission scope override. Null = inherit employee's roles
  /// (or full admin if employeeId is null).
  scopes     String[]  @default([])
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz()
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz()
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz()
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
  @@map("api_tokens")
}

// Organization (юр. лицо) — the selling/buying entity.
model Organization {
  id                     String    @id @default(uuid()) @db.Uuid
  accountId              String    @map("account_id") @db.Uuid
  ownerId                String?   @map("owner_id") @db.Uuid
  groupId                String?   @map("group_id") @db.Uuid
  name                   String    @db.VarChar(255)
  legalTitle             String?   @map("legal_title") @db.VarChar(255)
  legalAddress           String?   @map("legal_address")
  // Structured legal address (country/region/city/street/...).
  legalAddressFull       Json?     @map("legal_address_full")
  // Actual address often differs from legal in UZ (registered in oblast,
  // operates in the city centre).
  actualAddress          String?   @map("actual_address")
  actualAddressFull      Json?     @map("actual_address_full")
  companyType            String    @default("legalUZ") @map("company_type") @db.VarChar(20)
  email                  String?   @db.VarChar(255)
  phone                  String?   @db.VarChar(20)
  director               String?   @db.VarChar(255)
  directorPosition       String?   @map("director_position") @db.VarChar(255)
  chiefAccountant        String?   @map("chief_accountant") @db.VarChar(255)
  payerVat               Boolean   @default(true) @map("payer_vat")
  // UZ regional data: { inn: "STIR", okoned?: "...", mfo?: "..." }
  uzRequisites           Json?     @map("uz_requisites")
  // Document identity moysklad expects on organisations
  code                   String?   @db.VarChar(50)
  externalCode           String?   @map("external_code") @db.VarChar(50)
  syncId                 String?   @map("sync_id") @db.Uuid
  description            String?
  shared                 Boolean   @default(false)
  // Bonus tracking — moysklad lets organisations earn bonus points from
  // their suppliers (rare in UZ, kept for parity).
  bonusPoints            Int       @default(0) @map("bonus_points")
  bonusProgramId         String?   @map("bonus_program_id") @db.Uuid
  // EGAIS (Russian alcohol traceability) — disabled in UZ but moysklad
  // exposes the toggle. Always false for our region; field retained
  // because external imports may carry it.
  isEgaisEnable          Boolean   @default(false) @map("is_egais_enable")
  // Tobacco / pharma marking contract metadata (Honest Sign in RU).
  // UZ has its own "ASL Belgisi" so these fields are typically null.
  trackingContractDate   DateTime? @map("tracking_contract_date") @db.Date
  trackingContractNumber String?   @map("tracking_contract_number") @db.VarChar(50)
  archived               Boolean   @default(false)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version                Int       @default(1)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  account            Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner              Employee?                @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group              Group?                   @relation("OrganizationGroup", fields: [groupId], references: [id], onDelete: SetNull)
  bonusProgram       BonusProgram?            @relation("OrganizationBonusProgram", fields: [bonusProgramId], references: [id], onDelete: SetNull)
  customerOrders     CustomerOrder[]
  demands            Demand[]
  invoicesOut        InvoiceOut[]
  invoicesIn         InvoiceIn[]
  supplies           Supply[]
  purchaseOrders     PurchaseOrder[]
  paymentsIn         PaymentIn[]
  paymentsOut        PaymentOut[]
  salesReturns       SalesReturn[]
  purchaseReturns    PurchaseReturn[]
  moves              Move[]
  losses             Loss[]
  enters             Enter[]
  inventories        Inventory[]
  accounts           OrganizationAccount[]
  cashIns            CashIn[]
  cashOuts           CashOut[]
  cashierSessions    CashierSession[]
  retailSales        RetailSale[]             @relation("RetailSaleOrg")
  contracts          Contract[]               @relation("ContractOwnAgent")
  bonusOps           BonusOperation[]         @relation("BonusOpOrg")
  prepayments        Prepayment[]             @relation("PrepaymentOrg")
  prepayReturns      PrepaymentReturn[]       @relation("PrepayReturnOrg")
  internalOrders     InternalOrder[]          @relation("InternalOrderOrg")
  cpAdjustments      CounterpartyAdjustment[] @relation("CpAdjustmentOrg")
  priceLists         PriceList[]              @relation("PriceListOrg")
  retailDrawerIn     RetailDrawerCashIn[]     @relation("RetailDrawerInOrg")
  retailDrawerOut    RetailDrawerCashOut[]    @relation("RetailDrawerOutOrg")
  retailSalesReturns RetailSalesReturn[]      @relation("RetailSalesReturnOrg")
  productions        Production[]             @relation("ProductionOrg")
  processingOrders   ProcessingOrder[]        @relation("ProcessingOrderOrg")
  processings        Processing[]             @relation("ProcessingOrg")
  payrolls           Payroll[]                @relation("PayrollOrg")
  factureOuts        FactureOut[]             @relation("FactureOutOrg")
  factureIns         FactureIn[]              @relation("FactureInOrg")
  commReportOuts     CommissionReportOut[]    @relation("CommReportOutOrg")
  commReportIns      CommissionReportIn[]     @relation("CommReportInOrg")
  emissionOrders     EmissionOrder[]          @relation("EmissionOrderOrg")
  markingCodeOrders  MarkingCodeOrder[]       @relation("MarkingCodeOrderOrg")
  retireOrders       RetireOrder[]            @relation("RetireOrderOrg")
  retailStores       RetailStore[]            @relation("RetailStoreOrg")
  smenas             Smena[]                  @relation("SmenaOrganization")

  @@index([accountId, archived])
  @@map("organizations")
}

// =========================================================================
// Reference Data
// =========================================================================

// Store (ombor) — physical or logical inventory location.
model Store {
  id                 String   @id @default(uuid()) @db.Uuid
  accountId          String   @map("account_id") @db.Uuid
  ownerId            String?  @map("owner_id") @db.Uuid
  groupId            String?  @map("group_id") @db.Uuid
  // Self-reference for parent/child stores (warehouse hierarchy:
  // "Main warehouse" → "Section A" → "Shelf 1"). Null = root warehouse.
  parentId           String?  @map("parent_id") @db.Uuid
  name               String   @db.VarChar(255)
  code               String?  @db.VarChar(50)
  externalCode       String?  @map("external_code") @db.VarChar(50)
  description        String?
  address            String?
  // Structured address (city/street/...) — moysklad allows it on stores.
  addressFull        Json?    @map("address_full")
  // Cached path "Main / Section A / Shelf 1" — recomputed on parent change.
  pathName           String?  @map("path_name") @db.VarChar(500)
  // Stock zones (zoned warehouse: Cold / Frozen / Dry; or shelf rows).
  // Free-form list of names; allocation logic comes later.
  zones              String[] @default([])
  // Picking slots (bin codes inside zones — A1-12-3 style).
  slots              String[] @default([])
  shared             Boolean  @default(false)
  attributes         Json?    @default("{}")
  allowNegativeStock Boolean  @default(false) @map("allow_negative_stock")
  archived           Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version            Int      @default(1)

  account                       Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner                         Employee?           @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group                         Group?              @relation("StoreGroup", fields: [groupId], references: [id], onDelete: SetNull)
  parent                        Store?              @relation("StoreParent", fields: [parentId], references: [id], onDelete: SetNull)
  children                      Store[]             @relation("StoreParent")
  customerOrders                CustomerOrder[]
  demands                       Demand[]
  supplies                      Supply[]
  purchaseOrders                PurchaseOrder[]
  invoicesOut                   InvoiceOut[]        @relation("InvoiceOutStore")
  invoicesIn                    InvoiceIn[]         @relation("InvoiceInStore")
  retailSalesAt                 RetailSale[]        @relation("RetailSaleStore")
  internalOrders                InternalOrder[]     @relation("InternalOrderStore")
  retailSalesReturns            RetailSalesReturn[] @relation("RetailSalesReturnStore")
  productions                   Production[]        @relation("ProductionStore")
  productionsMaterials          Production[]        @relation("ProductionMaterialsStore")
  processingOrders              ProcessingOrder[]   @relation("ProcessingOrderStore")
  processingsAsMaterials        Processing[]        @relation("ProcessingMaterialsStore")
  processingsAsProducts         Processing[]        @relation("ProcessingProductsStore")
  retailStores                  RetailStore[]       @relation("RetailStoreStore")
  salesReturns                  SalesReturn[]
  purchaseReturns               PurchaseReturn[]
  movesFrom                     Move[]              @relation("MoveSourceStore")
  movesTo                       Move[]              @relation("MoveDestinationStore")
  losses                        Loss[]
  enters                        Enter[]
  inventories                   Inventory[]
  stockOperations               StockOperation[]
  stockReservations             StockReservation[]
  processingStageMaterialStores ProcessingStage[]   @relation("ProcessingStageMaterialStore")
  stocks                        Stock[]
  workOrders                    WorkOrder[]
  cashierSessions               CashierSession[]
  // Address storage (Адресное хранение) — moysklad parity. The legacy
  // `zones`/`slots` String[] above are the old free-text placeholder; these
  // relations are the real per-warehouse Zone/Cell model (см. StoreZone/StoreCell).
  addressZones                  StoreZone[]
  cells                         StoreCell[]
  stockByCell                   StockByCell[]

  @@unique([accountId, code])
  @@index([accountId, archived])
  @@index([accountId, parentId])
  @@map("stores")
}

// =========================================================================
// Address storage (Адресное хранение товаров) — moysklad parity.
// A warehouse organises stock into Zones (Зоны), each holding Cells (Ячейки);
// a document position may reference a cell, and stock can be tracked per cell.
// Managed in the warehouse card «Адресное хранение товаров». Tenancy is the
// scalar `accountId` (mirrors LossPosition) — cascade flows through `store`.
// =========================================================================

// StoreZone (Зона) — a named grouping of cells inside one warehouse.
// «Без зоны хранения» is the implicit null-zone bucket (a cell with zoneId=null),
// not a row here.
model StoreZone {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  name      String   @db.VarChar(255)
  // Stable display order in the warehouse card (moysklad keeps insertion order).
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cells StoreCell[]

  // Zone names are unique within a warehouse (moysklad rejects duplicates).
  @@unique([storeId, name])
  @@index([accountId, storeId])
  @@map("store_zones")
}

// StoreCell (Ячейка) — a physical bin inside a warehouse, optionally assigned to
// a Zone (zoneId=null ⇒ «Без зоны хранения»). Documents receive/write-off stock
// against a cell. Status (Свободна/Занята) is COMPUTED from stock-by-cell (built
// later, Phase 4); `barcode` (Штрихкод) supports scan-pick. Deleting a zone
// SetNull-s its cells (they fall back to the null-zone bucket), never deletes them.
model StoreCell {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  zoneId    String?  @map("zone_id") @db.Uuid
  name      String   @db.VarChar(255)
  barcode   String?  @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  store                   Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  zone                    StoreZone?               @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  // Documents that reference this cell (the position keeps a denormalized `cell`
  // label too); per-cell stock balances (Phase 4 «Свободна/Занята» + «С этим товаром»).
  lossPositions           LossPosition[]           @relation("LossPositionCell")
  enterPositions          EnterPosition[]          @relation("EnterPositionCell")
  supplyPositions         SupplyPosition[]         @relation("SupplyPositionCell")
  purchaseReturnPositions PurchaseReturnPosition[] @relation("PurchaseReturnPositionCell")
  salesReturnPositions    SalesReturnPosition[]    @relation("SalesReturnPositionCell")
  demandPositions         DemandPosition[]         @relation("DemandPositionCell")
  stockByCell             StockByCell[]

  // Cell names are unique within a warehouse (the picker identifies a cell by name).
  @@unique([storeId, name])
  @@index([accountId, storeId])
  @@index([zoneId])
  @@map("store_cells")
}

// OrganizationAccount — our own bank account (payer side). One Organization
// may have several; one is marked as default per currency.
model OrganizationAccount {
  id                   String   @id @default(uuid()) @db.Uuid
  accountId            String   @map("account_id") @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  name                 String   @db.VarChar(255)
  isDefault            Boolean  @default(false) @map("is_default")
  currency             String   @default("UZS") @db.VarChar(3)
  bankName             String?  @map("bank_name") @db.VarChar(255)
  // Bank address (moysklad account «Адрес банка»).
  bankLocation         String?  @map("bank_location") @db.VarChar(255)
  accountNumber        String?  @map("account_number") @db.VarChar(50)
  // Correspondent (corr-) account of the bank (moysklad «Корр счет»).
  correspondentAccount String?  @map("correspondent_account") @db.VarChar(50)
  // UZ MFO (routing code) / SWIFT BIC
  bic                  String?  @db.VarChar(20)
  // Materialized balance in minor units (tiyin for UZS). Updated by
  // MoneyOperation writes inside Serializable transactions.
  balanceMinor         BigInt   @default(0) @map("balance_minor")
  archived             Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version              Int      @default(1)

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operations         MoneyOperation[]
  bankStatements     BankStatement[]
  demands            Demand[]
  customerOrders     CustomerOrder[]     @relation("CustomerOrderOrgAccount")
  supplies           Supply[]            @relation("SupplyOrgAccount")
  purchaseOrders     PurchaseOrder[]     @relation("PurchaseOrderOrgAccount")
  invoicesOut        InvoiceOut[]        @relation("InvoiceOutOrgAccount")
  invoicesIn         InvoiceIn[]         @relation("InvoiceInOrgAccount")
  salesReturns       SalesReturn[]       @relation("SalesReturnOrgAccount")
  purchaseReturns    PurchaseReturn[]    @relation("PurchaseReturnOrgAccount")
  paymentsIn         PaymentIn[]         @relation("PaymentInOrgAccount")
  paymentsOut        PaymentOut[]        @relation("PaymentOutOrgAccount")
  cashierSessions    CashierSession[]    @relation("CashierSessionOrgAccount")
  retailSales        RetailSale[]        @relation("RetailSaleOrgAccount")
  contracts          Contract[]          @relation("ContractOrgAccount")
  prepayments        Prepayment[]        @relation("PrepaymentOrgAccount")
  prepayReturns      PrepaymentReturn[]  @relation("PrepayReturnOrgAccount")
  retailSalesReturns RetailSalesReturn[] @relation("RetailSalesReturnOrgAccount")
  retailStores       RetailStore[]       @relation("RetailStoreOrgAccount")
  processings        Processing[]        @relation("ProcessingOrgAccount")

  @@index([accountId, organizationId])
  @@index([accountId, archived])
  @@map("organization_accounts")
}

// CashDesk (касса) — physical cash register / till. Unlike bank accounts,
// cash desks are organization-independent but currency-scoped (a single
// cash box holds only one currency).
model CashDesk {
  // Sherset KEEP (debts) back-relation — B2
  debtPayments DebtPayment[]
  id           String        @id @default(uuid()) @db.Uuid
  accountId    String        @map("account_id") @db.Uuid
  name         String        @db.VarChar(255)
  currency     String        @default("UZS") @db.VarChar(3)
  balanceMinor BigInt        @default(0) @map("balance_minor")
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version      Int           @default(1)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  operations      MoneyOperation[]
  cashIns         CashIn[]
  cashOuts        CashOut[]
  cashierSessions CashierSession[]

  @@index([accountId, archived])
  @@map("cash_desks")
}

// MoneyOperation — append-only ledger mirroring StockOperation for money.
// Every PaymentIn/PaymentOut/CashIn/CashOut post writes one entry per
// money source; unpost writes a compensating entry. Used for reconciliation
// and auditing.
// ── Smena (POS navbat) tizimi — /sotuv sahifasi uchun ───────────────────────
// climart adoption (55cf3bf) buni «sherset-only» deb o'chirgan edi; /sotuv
// bo'limi bilan birga qaytarildi (2026-08-01). Manba — o'sha commitdan oldingi
// sxema; sherset.biznesjon.uz prod'ida ishlayotgan nusxa bilan bir xil.

model ShiftSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  name      String   @db.VarChar(100)
  startTime String   @map("start_time") @db.VarChar(5) // "08:00"
  endTime   String   @map("end_time") @db.VarChar(5) // "16:00"
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  smenas  Smena[]

  @@index([accountId, archived])
  @@map("shift_schedules")
}

model Smena {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  name           String   @db.VarChar(100)
  scheduleId     String   @map("schedule_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account      Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  schedule     ShiftSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  organization Organization     @relation("SmenaOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  employees    SmenaEmployee[]
  sessions     CashierSession[]

  @@index([accountId, archived])
  @@map("smenas")
}

model SmenaEmployee {
  smenaId    String @map("smena_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  smena    Smena    @relation(fields: [smenaId], references: [id], onDelete: Cascade)
  employee Employee @relation("SmenaEmployees", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([smenaId, employeeId])
  @@map("smena_employees")
}

// ── Omborchi (restock/sklad-keeper) tizimi — /sotuv sahifasi uchun ────────
// climart adoption (55cf3bf) bilan o'chgan; /sotuv «Rasmiylashtirish»
// oqimi (yig'ish varag'i + omborchi printeri) shularga tayanadi.

model SkladKeeper {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  skladNo      Int      @map("sklad_no")
  employeeId   String   @map("employee_id") @db.Uuid
  employeeName String?  @map("employee_name") @db.VarChar(255)
  // Windows printer name this warehouse's picking sheet is routed to (via the
  // local print-agent). Two sklads may share one printer (→ both receipts on it)
  // or use separate printers (→ each on its own). Null ⇒ falls back on print.
  printerName  String?  @map("printer_name") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([accountId, skladNo])
  @@index([accountId])
  @@map("sklad_keepers")
}

model RestockTask {
  id            String   @id @default(uuid()) @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  // Warehouse-task kind: 'restock' (inbound — put returned goods back) or
  // 'picking' (outbound — collect a sold order's goods for shipment). Picking
  // tasks are split per sklad (one task per warehouse zone / omborchi).
  type          String   @default("restock") @db.VarChar(20)
  // For picking tasks: the sklad (warehouse zone) number this task collects from
  // (the 1st segment of the bin code). Null for restock tasks.
  skladNo       Int?     @map("sklad_no")
  // Source document the goods relate to ('salesreturn' for restock,
  // 'customerorder' for picking).
  sourceType    String   @default("salesreturn") @map("source_type") @db.VarChar(30)
  sourceId      String   @map("source_id") @db.Uuid
  sourceName    String?  @map("source_name") @db.VarChar(255)
  storeId       String?  @map("store_id") @db.Uuid
  storeName     String?  @map("store_name") @db.VarChar(255)
  // The warehouse-keeper (omborchi) the task is assigned to. Nullable for
  // picking groups whose sklad has no keeper configured yet (shows unassigned).
  assigneeId    String?  @map("assignee_id") @db.Uuid
  assigneeName  String?  @map("assignee_name") @db.VarChar(255)
  // The cashier / employee who sent it.
  createdById   String   @map("created_by_id") @db.Uuid
  createdByName String?  @map("created_by_name") @db.VarChar(255)
  // pending | in_progress | done | cancelled
  // 'cancelled' — manba hujjat bekor qilinganda (RetailSale cancel'i ochiq
  // yig'ish topshiriqlarini shunga o'tkazadi; 'done' yolg'on bo'lardi).
  status        String   @default("pending") @db.VarChar(20)
  note          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  version       Int      @default(1)

  lines RestockTaskLine[]

  @@index([accountId, status, createdAt(sort: Desc)])
  @@index([accountId, assigneeId, status])
  @@index([accountId, sourceType, sourceId])
  @@index([accountId, type])
  @@map("restock_tasks")
}

model RestockTaskLine {
  id              String    @id @default(uuid()) @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  restockTaskId   String    @map("restock_task_id") @db.Uuid
  productId       String?   @map("product_id") @db.Uuid
  productName     String    @map("product_name") @db.VarChar(255)
  quantity        Decimal   @db.Decimal(20, 6)
  // Snapshot of the product's home location «NN-NN-NN-NN» at send time (null = unset).
  binLocation     String?   @map("bin_location") @db.VarChar(20)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz()
  confirmedById   String?   @map("confirmed_by_id") @db.Uuid
  confirmedByName String?   @map("confirmed_by_name") @db.VarChar(255)
  position        Int       @default(0)

  restockTask RestockTask @relation(fields: [restockTaskId], references: [id], onDelete: Cascade)

  @@index([restockTaskId, position])
  @@index([accountId, productId])
  @@map("restock_task_lines")
}

model MoneyOperation {
  id                    String   @id @default(uuid()) @db.Uuid
  accountId             String   @map("account_id") @db.Uuid
  at                    DateTime @default(now()) @db.Timestamptz()
  // Exactly one of (organizationAccountId, cashDeskId) is non-null.
  organizationAccountId String?  @map("organization_account_id") @db.Uuid
  cashDeskId            String?  @map("cash_desk_id") @db.Uuid
  // Signed delta in minor units — positive for inflow, negative for outflow.
  deltaMinor            BigInt   @map("delta_minor")
  currency              String   @db.VarChar(3)
  // Document linkage for drill-down.
  documentKind          String   @map("document_kind") @db.VarChar(30)
  documentId            String   @map("document_id") @db.Uuid
  counterpartyId        String?  @map("counterparty_id") @db.Uuid
  description           String?

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organizationAccount OrganizationAccount? @relation(fields: [organizationAccountId], references: [id], onDelete: SetNull)
  cashDesk            CashDesk?            @relation(fields: [cashDeskId], references: [id], onDelete: SetNull)

  @@index([accountId, organizationAccountId, at(sort: Desc)])
  @@index([accountId, cashDeskId, at(sort: Desc)])
  @@index([accountId, documentKind, documentId])
  @@index([accountId, counterpartyId, at(sort: Desc)])
  @@map("money_operations")
}

// BankStatement — a CSV upload of bank transactions awaiting review. The
// service parses the file into BankStatementRow entries; the user reviews
// matches + commits, which creates PaymentIn / PaymentOut drafts.
model BankStatement {
  id                    String   @id @default(uuid()) @db.Uuid
  accountId             String   @map("account_id") @db.Uuid
  uploadedBy            String?  @map("uploaded_by") @db.Uuid
  // Logical reference to the organization whose account this statement
  // relates to (informs inflow vs outflow direction).
  organizationAccountId String?  @map("organization_account_id") @db.Uuid
  filename              String   @db.VarChar(255)
  format                String   @default("csv") @db.VarChar(20)
  // Row counts captured at parse time — updated by commit() as rows transition.
  rowCountTotal         Int      @default(0) @map("row_count_total")
  rowCountMatched       Int      @default(0) @map("row_count_matched")
  rowCountImported      Int      @default(0) @map("row_count_imported")
  state                 String   @default("parsed") @db.VarChar(20) // parsed | committed | cancelled
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  uploader            Employee?            @relation("BankStatementUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  organizationAccount OrganizationAccount? @relation(fields: [organizationAccountId], references: [id], onDelete: SetNull)
  rows                BankStatementRow[]

  @@index([accountId, createdAt(sort: Desc)])
  @@map("bank_statements")
}

// BankStatementRow — one parsed transaction line. Keeps the raw fields
// plus an auto-matched counterpartyId (if the INN or account number hits a
// known counterparty) and a linked paymentInId/paymentOutId once committed.
model BankStatementRow {
  id                    String   @id @default(uuid()) @db.Uuid
  statementId           String   @map("statement_id") @db.Uuid
  accountId             String   @map("account_id") @db.Uuid
  lineNumber            Int      @map("line_number") // 1-based, preserves CSV order
  direction             String   @db.VarChar(10) // "in" | "out"
  moment                DateTime @db.Timestamptz()
  amountMinor           BigInt   @map("amount_minor")
  currency              String   @default("UZS") @db.VarChar(3)
  // Counterparty side as it appears in the statement.
  counterpartyName      String?  @map("counterparty_name") @db.VarChar(255)
  counterpartyInn       String?  @map("counterparty_inn") @db.VarChar(20)
  counterpartyAccount   String?  @map("counterparty_account") @db.VarChar(50)
  paymentPurpose        String?  @map("payment_purpose") @db.VarChar(500)
  documentNumber        String?  @map("document_number") @db.VarChar(50)
  // Auto-matched counterparty (nullable until user confirms in UI).
  matchedCounterpartyId String?  @map("matched_counterparty_id") @db.Uuid
  matchReason           String?  @map("match_reason") @db.VarChar(30) // "inn" | "account" | "manual"
  // Once the user commits, this is populated with the new draft.
  paymentInId           String?  @map("payment_in_id") @db.Uuid
  paymentOutId          String?  @map("payment_out_id") @db.Uuid
  skipped               Boolean  @default(false)
  error                 String?

  statement           BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedCounterparty Counterparty? @relation(fields: [matchedCounterpartyId], references: [id], onDelete: SetNull)
  paymentIn           PaymentIn?    @relation(fields: [paymentInId], references: [id], onDelete: SetNull)
  paymentOut          PaymentOut?   @relation(fields: [paymentOutId], references: [id], onDelete: SetNull)

  @@index([statementId, lineNumber])
  @@index([accountId, matchedCounterpartyId])
  @@map("bank_statement_rows")
}

// CounterpartyBalance — materialized per-currency balance for a counterparty.
// Sign convention: positive = counterparty OWES us (they are a debtor);
// negative = we OWE them (we are a debtor). Updated inside posting
// transactions by PaymentIn/Out, CashIn/Out, InvoiceOut/In, Demand, Supply.
//
// Uniqueness (counterpartyId, currency) lets a single counterparty hold
// balances in multiple currencies without duplicating rows.
model CounterpartyBalance {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  counterpartyId String   @map("counterparty_id") @db.Uuid
  currency       String   @db.VarChar(3)
  balanceMinor   BigInt   @default(0) @map("balance_minor")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@unique([counterpartyId, currency])
  @@index([accountId, counterpartyId])
  @@map("counterparty_balances")
}

// CashIn (приходный кассовый ордер, ПКО) — cash coming INTO a cash desk
// from a counterparty. Mirrors PaymentIn but targets a CashDesk instead of
// a bank account. Simple 3-state FSM (draft | posted | cancelled).
model CashIn {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100) // "ПКО-2026-00001"
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  agentId        String  @map("agent_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  cashDeskId     String  @map("cash_desk_id") @db.Uuid
  salesChannelId String? @map("sales_channel_id") @db.Uuid
  // moysklad parity — Договор / Проект (money doc has counterparty).
  contractId     String? @map("contract_id") @db.Uuid
  projectId      String? @map("project_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor    BigInt @default(0) @map("sum_minor")
  // VAT amount embedded in the cash sum (informational — moysklad still
  // expects the field even when accountant doesn't track VAT in cash docs).
  vatSumMinor BigInt @default(0) @map("vat_sum_minor")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  paymentPurpose String? @map("payment_purpose") @db.VarChar(500)
  description    String?
  shared         Boolean @default(false)
  printed        Boolean @default(false)
  published      Boolean @default(false)
  attributes     Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?         @relation("CashInOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?            @relation("CashInGroup", fields: [groupId], references: [id], onDelete: SetNull)
  agent        Counterparty      @relation(fields: [agentId], references: [id], onDelete: Restrict)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cashDesk     CashDesk          @relation(fields: [cashDeskId], references: [id], onDelete: Restrict)
  salesChannel SalesChannel?     @relation("CashInSalesChannel", fields: [salesChannelId], references: [id], onDelete: SetNull)
  contract     Contract?         @relation("CashInContract", fields: [contractId], references: [id], onDelete: SetNull)
  project      Project?          @relation("CashInProject", fields: [projectId], references: [id], onDelete: SetNull)
  operations   CashInOperation[]

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, cashDeskId])
  @@index([accountId, salesChannelId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("cash_in")
}

// CashInOperation — allocation of a CashIn amount to a specific
// InvoiceOut. Mirror of PaymentInOperation.
model CashInOperation {
  id        String @id @default(uuid()) @db.Uuid
  cashInId  String @map("cash_in_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  targetKind   String  @default("invoiceout") @map("target_kind") @db.VarChar(20)
  invoiceOutId String? @map("invoice_out_id") @db.Uuid

  amountMinor BigInt @map("amount_minor")

  cashIn     CashIn      @relation(fields: [cashInId], references: [id], onDelete: Cascade)
  invoiceOut InvoiceOut? @relation(fields: [invoiceOutId], references: [id], onDelete: SetNull)

  @@index([cashInId])
  @@index([accountId, invoiceOutId])
  @@map("cash_in_operations")
}

// CashOut (расходный кассовый ордер, РКО) — cash leaving a cash desk.
model CashOut {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100) // "РКО-2026-00001"
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  agentId        String  @map("agent_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  cashDeskId     String  @map("cash_desk_id") @db.Uuid
  salesChannelId String? @map("sales_channel_id") @db.Uuid
  // moysklad parity — Договор / Проект (money doc has counterparty).
  contractId     String? @map("contract_id") @db.Uuid
  projectId      String? @map("project_id") @db.Uuid
  // Account-level expense category tag ("Аренда", "Реклама", "Канцелярия")
  // for P&L roll-up. Free-form string; values managed in account settings.
  expenseItem    String? @map("expense_item") @db.VarChar(100)

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor    BigInt @default(0) @map("sum_minor")
  vatSumMinor BigInt @default(0) @map("vat_sum_minor")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  paymentPurpose String? @map("payment_purpose") @db.VarChar(500)
  description    String?
  shared         Boolean @default(false)
  printed        Boolean @default(false)
  published      Boolean @default(false)
  attributes     Json?   @default("{}")
  // moysklad flag for cash-outs against suppliers without a closing
  // document (i.e. paid in advance, no invoice yet). Drives "ожидает
  // документов" UI badge.
  noClosingDocs  Boolean @default(false) @map("no_closing_docs")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account      Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?          @relation("CashOutOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?             @relation("CashOutGroup", fields: [groupId], references: [id], onDelete: SetNull)
  agent        Counterparty       @relation(fields: [agentId], references: [id], onDelete: Restrict)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cashDesk     CashDesk           @relation(fields: [cashDeskId], references: [id], onDelete: Restrict)
  salesChannel SalesChannel?      @relation("CashOutSalesChannel", fields: [salesChannelId], references: [id], onDelete: SetNull)
  contract     Contract?          @relation("CashOutContract", fields: [contractId], references: [id], onDelete: SetNull)
  project      Project?           @relation("CashOutProject", fields: [projectId], references: [id], onDelete: SetNull)
  operations   CashOutOperation[]

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, cashDeskId])
  @@index([accountId, salesChannelId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("cash_out")
}

// CashOutOperation — allocation to InvoiceIn (mirror of PaymentOutOperation).
model CashOutOperation {
  id        String @id @default(uuid()) @db.Uuid
  cashOutId String @map("cash_out_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  targetKind  String  @default("invoicein") @map("target_kind") @db.VarChar(20)
  invoiceInId String? @map("invoice_in_id") @db.Uuid

  amountMinor BigInt @map("amount_minor")

  cashOut   CashOut    @relation(fields: [cashOutId], references: [id], onDelete: Cascade)
  invoiceIn InvoiceIn? @relation(fields: [invoiceInId], references: [id], onDelete: SetNull)

  @@index([cashOutId])
  @@index([accountId, invoiceInId])
  @@map("cash_out_operations")
}

// ProductImage — single image attached to a Product. Stored inline as
// bytea for MVP simplicity; can be lifted to S3 later by swapping the
// storage layer in ImageService and adding a `storageUrl` column.
//
// `position` controls grid order; `isMain` flags the cover image used in
// pickers and the catalog list. Exactly one row per product can have
// isMain=true (enforced at the service layer, not at the DB).
model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  // Variant-scoped images: when set, the image belongs to a single
  // variant rather than the parent product. moysklad lets variants have
  // their own image set (e.g. red T-shirt vs blue T-shirt).
  variantId String?  @map("variant_id") @db.Uuid
  filename  String   @db.VarChar(255)
  mime      String   @db.VarChar(100)
  // Image bytes. Null when the row is a placeholder (rare).
  content   Bytes
  // Original size in bytes — for display + quota accounting.
  sizeBytes Int      @map("size_bytes")
  position  Int      @default(0)
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation("VariantImage", fields: [variantId], references: [id], onDelete: Cascade)

  @@index([accountId, productId, position])
  @@index([accountId, variantId, position])
  @@map("product_images")
}

// BundleComponent — one line inside a bundle-kind Product's component list.
// Bundles (kind='bundle') don't hold stock themselves; their stock is
// derived from min(component_stock / component_qty) across the list.
// A component can reference either another Product or a Variant — the
// discriminator mirrors the assortmentKind pattern used on positions.
model BundleComponent {
  id                 String   @id @default(uuid()) @db.Uuid
  accountId          String   @map("account_id") @db.Uuid
  bundleId           String   @map("bundle_id") @db.Uuid
  componentProductId String?  @map("component_product_id") @db.Uuid
  componentVariantId String?  @map("component_variant_id") @db.Uuid
  // Units of the component needed per 1 unit of the bundle.
  quantity           Decimal  @db.Decimal(20, 6)
  // Display ordering inside the bundle's component list.
  position           Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bundle           Product  @relation("BundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  componentProduct Product? @relation("BundleComponentProduct", fields: [componentProductId], references: [id], onDelete: Restrict)
  componentVariant Variant? @relation(fields: [componentVariantId], references: [id], onDelete: Restrict)

  @@index([accountId, bundleId])
  @@index([accountId, componentProductId])
  @@index([accountId, componentVariantId])
  @@map("bundle_components")
}

// Variant (Модификация) — a SKU-level subdivision of a parent Product.
// The same product "T-Shirt" has multiple variants differentiated by
// characteristics (color, size, ...). Stock is tracked per-variant, so
// the parent Product.kind typically stays 'product' but positions can
// reference the variant directly via assortmentKind='variant'.
model Variant {
  id                  String   @id @default(uuid()) @db.Uuid
  accountId           String   @map("account_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  // Full variant name — moysklad format: "{parent_name} / {color} / {size}".
  name                String   @db.VarChar(255)
  code                String?  @db.VarChar(50)
  externalCode        String?  @map("external_code") @db.VarChar(50)
  description         String?
  // Single primary barcode (legacy) + array of all barcodes (moysklad
  // supports multiple per variant — EAN13, EAN8, UPC, custom).
  barcode             String?  @db.VarChar(50)
  barcodes            String[] @default([])
  // Per-variant overrides. When null, the parent Product value is used.
  // Shape: [{ priceTypeId, value, currencyCode }]
  salePrices          Json?    @map("sale_prices")
  buyPrice            BigInt?  @map("buy_price")
  minPrice            BigInt?  @map("min_price")
  // Characteristics as free-form pairs: [{ name: "Color", value: "Red" }, ...]
  // Ordering defines display order in the variant name.
  characteristics     Json     @default("[]")
  // Physical overrides (kg, ml, grams) — mostly null for variants.
  weightG             Int?     @map("weight_g")
  volumeML            Int?     @map("volume_ml")
  // Discount policy override (when null, parent Product's value applies).
  discountProhibited  Boolean  @default(false) @map("discount_prohibited")
  // Re-order alert threshold per variant — same Minor convention as
  // Product.minimumBalanceMinor.
  minimumBalanceMinor BigInt   @default(0) @map("minimum_balance_minor")
  archived            Boolean  @default(false)
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account             Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  asBundleComponentIn BundleComponent[]
  packs               ProductPack[]     @relation("VariantPack")
  images              ProductImage[]    @relation("VariantImage")
  consignments        Consignment[]     @relation("VariantConsignment")

  @@unique([accountId, code])
  @@unique([accountId, barcode])
  @@index([accountId, productId])
  @@index([accountId, archived])
  @@map("variants")
}

// Characteristic (Характеристика модификации) — account-level dictionary of
// variant characteristics (e.g. «Цвет», «Размер»). moysklad model: a reusable
// { id, name, type:'string' } entry. A Variant references it by name+value inside
// its `characteristics` JSON ([{ name, value }]). We keep the dictionary so the
// «Создание модификаций» modal can suggest existing characteristic names and
// remember new ones — mirroring moysklad's characteristic dropdown (which lists
// every characteristic created on the account). The value list is NOT a fixed
// dictionary in moysklad (free text per modification), so only the name is stored.
model Characteristic {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name])
  @@index([accountId])
  @@map("characteristics")
}

// Call — communication log entry. Tracks calls/SMS/email conversations
// with a counterparty (or unknown caller). MVP supports manual entry;
// telephony integration (click-to-call, auto-log via webhook) lands in
// a later sprint.
//
// counterpartyId is nullable so the user can log a call from an unknown
// number and link it later. Same for contactPersonId — even known
// counterparties may not have the specific person known yet.
model Call {
  id              String  @id @default(uuid()) @db.Uuid
  accountId       String  @map("account_id") @db.Uuid
  counterpartyId  String? @map("counterparty_id") @db.Uuid
  contactPersonId String? @map("contact_person_id") @db.Uuid
  ownerId         String? @map("owner_id") @db.Uuid

  // 'in' (incoming) | 'out' (outgoing).
  direction      String   @db.VarChar(10)
  // 'call' | 'sms' | 'email' | 'meeting'.
  channel        String   @default("call") @db.VarChar(20)
  // 'completed' | 'missed' | 'cancelled' | 'scheduled'.
  status         String   @default("completed") @db.VarChar(20)
  startedAt      DateTime @map("started_at") @db.Timestamptz()
  // Duration in seconds (null for SMS/email or scheduled-but-not-done).
  durationSec    Int?     @map("duration_sec")
  // Either party's external phone/email (for unknown caller logging).
  externalNumber String?  @map("external_number") @db.VarChar(50)
  summary        String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty  Counterparty?  @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  contactPerson ContactPerson? @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)
  owner         Employee?      @relation("CallOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([accountId, counterpartyId, startedAt(sort: Desc)])
  @@index([accountId, ownerId, startedAt(sort: Desc)])
  @@index([accountId, startedAt(sort: Desc)])
  @@index([accountId, archived])
  @@map("calls")
}

// CounterpartyNote — a CRM «Заметка» (free-text note) shown on the counterparty card's
// «События» tab. moysklad's «Создать заметку» composer writes one; the «Заметки» sub-filter
// lists them and «Все события» merges them with calls + audit events.
model CounterpartyNote {
  id             String  @id @default(uuid()) @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  counterpartyId String  @map("counterparty_id") @db.Uuid
  authorId       String? @map("author_id") @db.Uuid

  text      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  author       Employee?    @relation("CounterpartyNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([accountId, counterpartyId, createdAt(sort: Desc)])
  @@map("counterparty_notes")
}

// Task — internal to-do / reminder item. Optionally linked (polymorphic)
// to any document via entity+entityId (no FK — same pattern as Attachment).
model Task {
  id         String  @id @default(uuid()) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  authorId   String? @map("author_id") @db.Uuid
  assigneeId String? @map("assignee_id") @db.Uuid
  // Counterparty the task is about (e.g. "Call ACME on Friday").
  agentId    String? @map("agent_id") @db.Uuid

  title             String  @db.VarChar(255)
  description       String?
  // moysklad records which app emitted the task (e.g. "API Integration",
  // "Mobile". For us it'll usually be null = manual / web).
  authorApplication String? @map("author_application") @db.VarChar(100)
  // Free-form operation tag — moysklad uses this on tasks linked to
  // documents to pin the action ("call back about invoice X", "deliver
  // order Y"). Null for ad-hoc tasks.
  operation         String? @db.VarChar(100)

  // Polymorphic link — no FK. Mirrors Attachment pattern.
  entity   String? @db.VarChar(50)
  entityId String? @map("entity_id") @db.Uuid

  // 'open' | 'in_progress' | 'done' | 'cancelled'
  status   String @default("open") @db.VarChar(20)
  // 'low' | 'normal' | 'high' | 'urgent'
  priority String @default("normal") @db.VarChar(10)

  // LEGACY «Тип задачи» — a separate TaskType lookup. Superseded by `stateId`
  // below: moysklad's task `state` (a State row, entityType="task") IS the
  // «Тип задачи». Kept (dormant, SetNull) so old rows/history don't break;
  // new tasks set `stateId`. Drop in a later destructive migration.
  typeId String? @map("type_id") @db.Uuid

  // moysklad «Тип задачи» — the task's `state` (State row, entityType="task"),
  // matching moysklad's own `task.state` API field. Account-defined coloured
  // list (Вазифа / Текшириш / Мухим иш …) managed in /settings/task-statuses.
  // Null = no type chosen. SetNull so deleting a state just unlinks its tasks.
  stateId String? @map("state_id") @db.Uuid

  dueAt       DateTime? @map("due_at") @db.Timestamptz()
  // Set when entering done/cancelled; cleared when reverting to open/in_progress
  completedAt DateTime? @map("completed_at") @db.Timestamptz()
  // Boolean mirror of (status === 'done'). Maintained by service code so
  // moysklad's `done` boolean field has a direct equivalent — drives
  // reports that count completed tasks without joining the status string.
  done        Boolean   @default(false)

  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int      @default(1)

  // === HR module fields (P0 sprint) ===
  // kind=CRM (default) → moysklad standart vazifa (CRM follow-up etc.)
  // kind=HR  → xodimga yuborilgan topshiriq (4-ko'z review, deadline, bonus/fine).
  // HR fields nullable for CRM tasks.
  kind              TaskKind @default(CRM)
  hrTemplateId      String?  @map("hr_template_id") @db.Uuid
  hrCheckerId       String?  @map("hr_checker_id") @db.Uuid
  hrResponseType    String?  @default("none") @map("hr_response_type") @db.VarChar(20)
  hrDeadlineMinutes Int?     @map("hr_deadline_minutes")
  hrRewardMinor     BigInt?  @map("hr_reward_minor")
  hrFineMinor       BigInt?  @map("hr_fine_minor")
  hrDependsOnId     String?  @map("hr_depends_on_id") @db.Uuid

  account  Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  author   Employee?     @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  assignee Employee?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  agent    Counterparty? @relation("TaskAgent", fields: [agentId], references: [id], onDelete: SetNull)
  type     TaskType?     @relation(fields: [typeId], references: [id], onDelete: SetNull)
  state    State?        @relation("TaskState", fields: [stateId], references: [id], onDelete: SetNull)

  hrTemplate HrTaskTemplate? @relation(fields: [hrTemplateId], references: [id])
  hrTaskLog  HrTaskLog?

  @@index([accountId, assigneeId, status, dueAt])
  @@index([accountId, entity, entityId])
  @@index([accountId, status, archived])
  @@index([accountId, agentId])
  @@index([accountId, typeId])
  @@index([accountId, stateId])
  @@map("tasks")
}

// moysklad «Тип задачи» — account-scoped lookup that lets users tag tasks
// with a categorical label (Call, Meeting, Follow-up, …) plus a colour
// for the badge. Managed in /settings/task-types. Position drives the
// dropdown ordering. Soft-archive only — referencing tasks survive via
// onDelete: SetNull.
model TaskType {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  name      String  @db.VarChar(255)
  // Hex colour for UI badge (e.g. "#16A34A"). Optional — null = neutral grey.
  color     String? @db.VarChar(9)
  position  Int     @default(0)
  archived  Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([accountId, name])
  @@index([accountId, archived, position])
  @@map("task_types")
}

// Notification — in-app notification targeted at a specific Employee.
// Emitted by services (task assigned, opportunity won/lost, etc.) and
// surfaced as a bell-icon dropdown in the top bar. No FK on entity/entityId
// (polymorphic link, same pattern as Attachment and Task).
model Notification {
  id          String @id @default(uuid()) @db.Uuid
  accountId   String @map("account_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  // 'task_assigned' | 'task_due_soon' | 'task_overdue' | 'opportunity_won' |
  // 'opportunity_lost' | 'invoice_paid' | 'invoice_overdue' | 'mention' | 'system'
  kind String @db.VarChar(40)

  title String  @db.VarChar(255)
  body  String?

  // Polymorphic link — no FK.
  entity   String? @db.VarChar(50)
  entityId String? @map("entity_id") @db.Uuid

  // null = unread; non-null = read
  readAt DateTime? @map("read_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recipient Employee @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // Main query path: unread + recent for a specific employee
  @@index([accountId, recipientId, readAt, createdAt(sort: Desc)])
  // Fallback for "all notifications" list
  @@index([accountId, recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ContactPerson — additional contact people belonging to a Counterparty.
// Counterparty itself has top-level phone/email, but a single legal entity
// usually has multiple humans (director, accountant, sales, ...). moysklad
// surfaces these as "Контактные лица" on the counterparty page and on a
// standalone /contact-persons list.
model ContactPerson {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  counterpartyId String   @map("counterparty_id") @db.Uuid
  ownerId        String?  @map("owner_id") @db.Uuid
  name           String   @db.VarChar(255)
  position       String?  @db.VarChar(255)
  phone          String?  @db.VarChar(20)
  email          String?  @db.VarChar(255)
  description    String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty    Counterparty     @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  owner           Employee?        @relation("ContactPersonOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  calls           Call[]
  opportunities   Opportunity[]
  serviceRequests ServiceRequest[] @relation("ServiceRequestContact")

  @@index([accountId, counterpartyId])
  @@index([accountId, archived])
  @@map("contact_persons")
}

// PriceType — named price list (e.g. "Default", "Wholesale", "Promo").
// Every account has at least one "Default" type; additional types let
// products hold multiple simultaneous prices. Referenced by
// Product.salePrices JSON (priceTypeId → value).
model PriceType {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  name         String   @db.VarChar(100)
  externalCode String?  @map("external_code") @db.VarChar(50)
  currency     String   @default("UZS") @db.VarChar(3)
  isDefault    Boolean  @default(false) @map("is_default")
  // Display ordering in pickers (lower = first).
  position     Int      @default(0)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparties Counterparty[]
  priceLists     PriceList[]    @relation("PriceListPriceType")
  retailStores   RetailStore[]  @relation("RetailStorePriceType")

  @@unique([accountId, name])
  @@index([accountId, archived])
  @@map("price_types")
}

// Product Folder — hierarchical category tree.
model ProductFolder {
  id                  String   @id @default(uuid()) @db.Uuid
  accountId           String   @map("account_id") @db.Uuid
  ownerId             String?  @map("owner_id") @db.Uuid
  groupId             String?  @map("group_id") @db.Uuid
  parentId            String?  @map("parent_id") @db.Uuid
  name                String   @db.VarChar(255)
  code                String?  @db.VarChar(50)
  externalCode        String?  @map("external_code") @db.VarChar(50)
  pathName            String?  @map("path_name")
  description         String?
  shared              Boolean  @default(false)
  useParentVat        Boolean  @default(true) @map("use_parent_vat")
  vat                 Int? // VAT % (0, 12, or null for "Without VAT")
  vatEnabled          Boolean  @default(true) @map("vat_enabled")
  // Cached resolved VAT — folder.vat or parent.effectiveVat. Null when
  // useParentVat=true and no ancestor sets vat. Recomputed on save.
  effectiveVat        Int?     @map("effective_vat")
  effectiveVatEnabled Boolean  @default(true) @map("effective_vat_enabled")
  taxSystem           String?  @map("tax_system") @db.VarChar(30)
  archived            Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account  Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner    Employee?       @relation("ProductFolderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group    Group?          @relation("ProductFolderGroup", fields: [groupId], references: [id], onDelete: SetNull)
  parent   ProductFolder?  @relation("ProductFolderSelf", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductFolder[] @relation("ProductFolderSelf")
  products Product[]

  @@unique([accountId, code])
  @@index([accountId, archived])
  @@index([accountId, parentId])
  @@map("product_folders")
}

// Counterparty (mijoz / ta'minlovchi / ikkisi).
model Counterparty {
  // Sherset KEEP (debts) back-relation — B2
  debts                Debt[]
  // Sherset KEEP (telegram) back-relations — B3
  telegramChats        TelegramChat[]
  telegramBackfillJobs TelegramBackfillJob[] @relation("TgBackfillCp")
  id                   String                @id @default(uuid()) @db.Uuid
  accountId            String                @map("account_id") @db.Uuid
  ownerId              String?               @map("owner_id") @db.Uuid
  groupId              String?               @map("group_id") @db.Uuid
  priceTypeId          String?               @map("price_type_id") @db.Uuid
  stateId              String?               @map("state_id") @db.Uuid
  bonusProgramId       String?               @map("bonus_program_id") @db.Uuid
  // «Кто изменил» — last employee to update this record (stamped on update).
  // Mirrors Product.modifiedById. Nullable: rows created before this column.
  modifiedById         String?               @map("modified_by_id") @db.Uuid
  name                 String                @db.VarChar(255)
  legalTitle           String?               @map("legal_title") @db.VarChar(255)
  legalAddress         String?               @map("legal_address")
  // Structured legal address: { country, region, city, street, house, apartment, postalCode, addInfo }
  legalAddressFull     Json?                 @map("legal_address_full")
  // Actual address (often differs from legal in UZ — registered in oblast, operating in city)
  actualAddress        String?               @map("actual_address") @db.VarChar(255)
  actualAddressFull    Json?                 @map("actual_address_full")
  companyType          String                @default("legalUZ") @map("company_type") @db.VarChar(20)
  email                String?               @db.VarChar(255)
  phone                String?               @db.VarChar(20)
  fax                  String?               @db.VarChar(50)
  tags                 String[]              @default([])
  // Custom user-defined fields. Universal moysklad pattern; key = attribute slug, value = scalar/object.
  attributes           Json?                 @default("{}")
  // UZ regional data: { inn: "STIR", okoned?: "...", mfo?: "..." }
  uzRequisites         Json?                 @map("uz_requisites")
  description          String?
  code                 String?               @db.VarChar(50)
  // External system sync key (1C, e-commerce, ...). Immutable once set.
  externalCode         String?               @map("external_code") @db.VarChar(255)
  syncId               String?               @map("sync_id") @db.Uuid
  // Discount card + per-counterparty personal discounts (rule list as JSON).
  discountCardNumber   String?               @map("discount_card_number") @db.VarChar(100)
  discounts            Json?
  // Bonus program tracking (out-of-band program model TBD; counter is local).
  bonusPoints          Int                   @default(0) @map("bonus_points")
  shared               Boolean               @default(false)
  archived             Boolean               @default(false)
  // Sales amount aggregate (updated by stock/money ledgers).
  salesAmount          BigInt                @default(0) @map("sales_amount")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version              Int                   @default(1)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz()

  account            Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner              Employee?                @relation("CounterpartyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  modifiedBy         Employee?                @relation("CounterpartyModifiedBy", fields: [modifiedById], references: [id], onDelete: SetNull)
  group              Group?                   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // moysklad «Группы» — many-to-many counterparty grouping (named groups), SEPARATE
  // from `group`/«Отдел» (the access department above). m2m so a counterparty can be
  // in several at once (the mass-edit «Установить/Добавить/Убрать группы» modes).
  groups             CounterpartyGroup[]      @relation("CounterpartyGroups")
  priceType          PriceType?               @relation(fields: [priceTypeId], references: [id], onDelete: SetNull)
  state              State?                   @relation(fields: [stateId], references: [id], onDelete: SetNull)
  bonusProgram       BonusProgram?            @relation(fields: [bonusProgramId], references: [id], onDelete: SetNull)
  bankAccounts       CounterpartyAccount[]
  customerOrders     CustomerOrder[]
  demands            Demand[]
  demandsAsConsignor Demand[]                 @relation("DemandConsignor")
  demandsAsConsignee Demand[]                 @relation("DemandConsignee")
  demandsAsCarrier   Demand[]                 @relation("DemandCarrier")
  invoicesOut        InvoiceOut[]
  invoicesIn         InvoiceIn[]
  supplies           Supply[]
  purchaseOrders     PurchaseOrder[]
  paymentsIn         PaymentIn[]
  paymentsOut        PaymentOut[]
  salesReturns       SalesReturn[]
  purchaseReturns    PurchaseReturn[]
  cashIns            CashIn[]
  cashOuts           CashOut[]
  balances           CounterpartyBalance[]
  bankStatementRows  BankStatementRow[]
  contactPersons     ContactPerson[]
  calls              Call[]
  notes              CounterpartyNote[]
  opportunities      Opportunity[]
  retailSales        RetailSale[]
  suppliedProducts   Product[]                @relation("ProductSupplier")
  tasks              Task[]                   @relation("TaskAgent")
  contracts          Contract[]               @relation("ContractAgent")
  bonusOps           BonusOperation[]         @relation("BonusOpAgent")
  prepayments        Prepayment[]             @relation("PrepaymentAgent")
  prepayReturns      PrepaymentReturn[]       @relation("PrepayReturnAgent")
  cpAdjustments      CounterpartyAdjustment[] @relation("CpAdjustmentAgent")
  retailDrawerIn     RetailDrawerCashIn[]     @relation("RetailDrawerInAgent")
  retailDrawerOut    RetailDrawerCashOut[]    @relation("RetailDrawerOutAgent")
  retailSalesReturns RetailSalesReturn[]      @relation("RetailSalesReturnAgent")
  factureOuts        FactureOut[]             @relation("FactureOutAgent")
  factureIns         FactureIn[]              @relation("FactureInAgent")
  commReportOuts     CommissionReportOut[]    @relation("CommReportOutAgent")
  commReportIns      CommissionReportIn[]     @relation("CommReportInAgent")
  serviceRequests    ServiceRequest[]         @relation("ServiceRequestCp")

  hrChatHistories HrChatHistory[]    @relation("HrChatHistoryCp")
  hrOutboxEntries HrTelegramOutbox[] @relation("HrOutboxCp")

  @@index([accountId, archived])
  @@index([accountId, companyType])
  @@index([groupId])
  @@index([stateId])
  @@index([accountId, modifiedById])
  // Trigram GIN (perf audit 2026-07-23) — counterparty name ILIKE search.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "counterparties_name_trgm_idx")
  @@map("counterparties")
}

// Department / team grouping. Mirrors moysklad's Group entity (Отделы).
// Used by Counterparty (sales rep team), and downstream entities.
model Group {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  name      String   @db.VarChar(255)
  // Display order for sidebar / picklist.
  index     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account               Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparties        Counterparty[]
  products              Product[]
  moves                 Move[]                   @relation("MoveGroup")
  losses                Loss[]                   @relation("LossGroup")
  enters                Enter[]                  @relation("EnterGroup")
  inventories           Inventory[]              @relation("InventoryGroup")
  cashIns               CashIn[]                 @relation("CashInGroup")
  cashOuts              CashOut[]                @relation("CashOutGroup")
  cashierSessions       CashierSession[]         @relation("CashierSessionGroup")
  retailSales           RetailSale[]             @relation("RetailSaleGroup")
  organizations         Organization[]           @relation("OrganizationGroup")
  stores                Store[]                  @relation("StoreGroup")
  salesChannels         SalesChannel[]           @relation("SalesChannelGroup")
  productFolders        ProductFolder[]          @relation("ProductFolderGroup")
  countries             Country[]                @relation("CountryGroup")
  uoms                  Uom[]                    @relation("UomGroup")
  taxRates              TaxRate[]                @relation("TaxRateGroup")
  projects              Project[]                @relation("ProjectGroup")
  contracts             Contract[]               @relation("ContractGroup")
  bonusOps              BonusOperation[]         @relation("BonusOpGroup")
  prepayments           Prepayment[]             @relation("PrepaymentGroup")
  prepayReturns         PrepaymentReturn[]       @relation("PrepayReturnGroup")
  internalOrders        InternalOrder[]          @relation("InternalOrderGroup")
  cpAdjustments         CounterpartyAdjustment[] @relation("CpAdjustmentGroup")
  priceLists            PriceList[]              @relation("PriceListGroup")
  retailDrawerIn        RetailDrawerCashIn[]     @relation("RetailDrawerInGroup")
  retailDrawerOut       RetailDrawerCashOut[]    @relation("RetailDrawerOutGroup")
  retailSalesReturns    RetailSalesReturn[]      @relation("RetailSalesReturnGroup")
  processingProcesses   ProcessingProcess[]      @relation("ProcessingProcessGroup")
  processingStages      ProcessingStage[]        @relation("ProcessingStageGroup")
  processingPlanFolders ProcessingPlanFolder[]   @relation("ProcessingPlanFolderGroup")
  productions           Production[]             @relation("ProductionGroup")
  processingOrders      ProcessingOrder[]        @relation("ProcessingOrderGroup")
  processings           Processing[]             @relation("ProcessingGroup")
  payrolls              Payroll[]                @relation("PayrollGroup")
  factureOuts           FactureOut[]             @relation("FactureOutGroup")
  factureIns            FactureIn[]              @relation("FactureInGroup")
  commReportOuts        CommissionReportOut[]    @relation("CommReportOutGroup")
  commReportIns         CommissionReportIn[]     @relation("CommReportInGroup")
  emissionOrders        EmissionOrder[]          @relation("EmissionOrderGroup")
  markingCodeOrders     MarkingCodeOrder[]       @relation("MarkingCodeOrderGroup")
  retireOrders          RetireOrder[]            @relation("RetireOrderGroup")
  retailStores          RetailStore[]            @relation("RetailStoreGroup")
  serviceRequests       ServiceRequest[]         @relation("ServiceRequestGroup")

  @@unique([accountId, name])
  @@index([accountId])
  @@map("groups")
}

// moysklad «Группы контрагентов» — flat, account-scoped NAMED groups, many-to-many
// with Counterparty (a counterparty can belong to several). This is the list «Группы»
// column + the mass-edit «Установить/Добавить/Убрать группы» modes. SEPARATE from
// `Group` above («Отдел» / the access department) — do NOT conflate the two.
model CounterpartyGroup {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  name      String   @db.VarChar(255)
  // Display order in the «Группы» picklist/filter.
  index     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparties Counterparty[] @relation("CounterpartyGroups")

  @@unique([accountId, name])
  @@index([accountId])
  @@map("counterparty_groups")
}

// Bank account belonging to a Counterparty. Multiple accounts allowed;
// one is marked default. UZ bank fields: MFO (5-digit code), bankInn (STIR).
model CounterpartyAccount {
  id                   String   @id @default(uuid()) @db.Uuid
  accountId            String   @map("account_id") @db.Uuid
  counterpartyId       String   @map("counterparty_id") @db.Uuid
  // The actual settlement account number (расчётный счёт).
  accountNumber        String   @map("account_number") @db.VarChar(50)
  bankName             String?  @map("bank_name") @db.VarChar(255)
  bankLocation         String?  @map("bank_location") @db.VarChar(255)
  // Correspondent (corr-) account of the bank itself.
  correspondentAccount String?  @map("correspondent_account") @db.VarChar(50)
  // UZ bank routing code — 5 digits (e.g. "00014").
  mfo                  String?  @db.VarChar(10)
  // Bank's own STIR (tax ID).
  bankInn              String?  @map("bank_inn") @db.VarChar(20)
  // SWIFT/BIC for international transfers.
  swift                String?  @db.VarChar(20)
  // Currency code (ISO 4217). Default UZS.
  currency             String   @default("UZS") @db.VarChar(3)
  isMain               Boolean  @default(false) @map("is_main")
  archived             Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty       Counterparty        @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  demands            Demand[]
  customerOrders     CustomerOrder[]     @relation("CustomerOrderAgentAccount")
  supplies           Supply[]            @relation("SupplyAgentAccount")
  purchaseOrders     PurchaseOrder[]     @relation("PurchaseOrderAgentAccount")
  invoicesOut        InvoiceOut[]        @relation("InvoiceOutAgentAccount")
  invoicesIn         InvoiceIn[]         @relation("InvoiceInAgentAccount")
  salesReturns       SalesReturn[]       @relation("SalesReturnAgentAccount")
  purchaseReturns    PurchaseReturn[]    @relation("PurchaseReturnAgentAccount")
  paymentsIn         PaymentIn[]         @relation("PaymentInAgentAccount")
  paymentsOut        PaymentOut[]        @relation("PaymentOutAgentAccount")
  retailSales        RetailSale[]        @relation("RetailSaleAgentAccount")
  contracts          Contract[]          @relation("ContractAgentAccount")
  prepayments        Prepayment[]        @relation("PrepaymentAgentAccount")
  prepayReturns      PrepaymentReturn[]  @relation("PrepayReturnAgentAccount")
  retailSalesReturns RetailSalesReturn[] @relation("RetailSalesReturnAgentAccount")

  @@index([accountId, counterpartyId])
  @@index([counterpartyId, isMain])
  @@map("counterparty_accounts")
}

// Polymorphic workflow state. Mirrors moysklad's State entity which is shared
// across counterparties, customer orders, demands, etc. Each row scopes to
// one entityType + accountId; the consumer model holds a nullable stateId FK.
//
// stateType drives reporting:
//   Regular       — neutral progress states ("Negotiating", "Sent")
//   Successful    — terminal-success ("Paid", "Delivered")
//   Unsuccessful  — terminal-failure ("Cancelled", "Refunded")
model State {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(40)
  name       String   @db.VarChar(255)
  // Hex colour for UI badges (e.g. "#16A34A").
  color      String?  @db.VarChar(9)
  stateType  String   @default("Regular") @map("state_type") @db.VarChar(20)
  position   Int      @default(0)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparties       Counterparty[]
  customerOrders       CustomerOrder[]       @relation("CustomerOrderStatus")
  purchaseOrders       PurchaseOrder[]       @relation("PurchaseOrderStatus")
  supplies             Supply[]              @relation("SupplyStatus")
  purchaseReturns      PurchaseReturn[]      @relation("PurchaseReturnStatus")
  salesReturns         SalesReturn[]         @relation("SalesReturnStatus")
  demands              Demand[]              @relation("DemandStatus")
  tasks                Task[]                @relation("TaskState")
  commissionReportsOut CommissionReportOut[] @relation("CommReportOutStatus")
  commissionReportsIn  CommissionReportIn[]  @relation("CommReportInStatus")
  invoicesOut          InvoiceOut[]          @relation("InvoiceOutStatus")

  @@unique([accountId, entityType, name])
  @@index([accountId, entityType, archived])
  @@map("states")
}

// Loyalty / bonus programme. Counterparties opt-in via FK; bonusPoints lives
// on Counterparty as a denormalised counter (program defines accrual rules).
//
// transactionType:  EARNING (accrue) | SPENDING (redeem) — drives operations
// allAgents=false   ⇒ programme limited to specific agentTags
model BonusProgram {
  id                 String    @id @default(uuid()) @db.Uuid
  accountId          String    @map("account_id") @db.Uuid
  name               String    @db.VarChar(255)
  // ISO 4217 currency, default UZS.
  currency           String    @default("UZS") @db.VarChar(3)
  // Floor of points required to redeem.
  earnRateRulesJson  Json?     @map("earn_rate_rules")
  // Earn / spend toggle for the program globally.
  transactionType    String    @default("EARNING") @map("transaction_type") @db.VarChar(20)
  allAgents          Boolean   @default(true) @map("all_agents")
  agentTags          String[]  @default([]) @map("agent_tags")
  allProducts        Boolean   @default(true) @map("all_products")
  active             Boolean   @default(true)
  archived           Boolean   @default(false)
  // ISO date — programme starts accruing on/after this date.
  applicableFromDate DateTime? @map("applicable_from_date") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  account        Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparties Counterparty[]
  organizations  Organization[]   @relation("OrganizationBonusProgram")
  bonusOps       BonusOperation[] @relation("BonusOpProgram")

  @@unique([accountId, name])
  @@index([accountId, archived])
  @@map("bonus_programs")
}

// =========================================================================
// Reference data — lookup tables (moysklad fidelity)
// =========================================================================
//
// These models replace what we previously hardcoded as string literals
// (UZS / "шт" / 12% VAT / UZ / etc). Each is owned per-account so users
// can customise their lookup sets — one of moysklad's core differentiators
// vs simpler ERPs.

/// Country lookup — ISO 3166-1 alpha-2 + display name. Pre-seeded with
/// the full country list per account; users typically don't add new ones.
model Country {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  ownerId      String?  @map("owner_id") @db.Uuid
  groupId      String?  @map("group_id") @db.Uuid
  name         String   @db.VarChar(255)
  code         String?  @db.VarChar(10) // ISO 3166-1 alpha-2 / alpha-3
  externalCode String?  @map("external_code") @db.VarChar(50)
  description  String?
  shared       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner   Employee? @relation("CountryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group   Group?    @relation("CountryGroup", fields: [groupId], references: [id], onDelete: SetNull)

  supplyPositions      SupplyPosition[]      @relation("SupplyPositionCountry")
  salesReturnPositions SalesReturnPosition[] @relation("SalesReturnPositionCountry")
  enterPositions       EnterPosition[]       @relation("EnterPositionCountry")

  @@unique([accountId, code])
  @@map("countries")
}

/// UZ Region lookup — 14 administrative regions of Uzbekistan +
/// Tashkent city as a separate entity. moysklad's Region is global;
/// for UZ-clone we narrow to UZ-specific.
model Region {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  name         String   @db.VarChar(255)
  /// ISO 3166-2 sub-code (e.g. "UZ-TA" Tashkent City, "UZ-AN" Andijan)
  code         String?  @db.VarChar(10)
  externalCode String?  @map("external_code") @db.VarChar(50)
  /// Optimistic concurrency version (moysklad parity).
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, code])
  @@map("regions")
}

/// Currency lookup — moysklad models currency as a per-account entity
/// with rate management. We pre-seed UZS (system, base) + USD/RUB/EUR.
/// rate stores the exchange rate to the account's base currency × 10^8.
model Currency {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  /// ISO 4217 code (UZS, USD, EUR, RUB...). Unique per account.
  code           String   @db.VarChar(3)
  /// ISO numeric code (UZS=860). Optional — populated for system currencies.
  isoCode        String?  @map("iso_code") @db.VarChar(3)
  name           String   @db.VarChar(100)
  fullName       String?  @map("full_name") @db.VarChar(255)
  /// True for the account's base currency. Exactly one row has default=true.
  default        Boolean  @default(false)
  /// True when rate is "indirect" (1 base = X foreign), false for direct.
  indirect       Boolean  @default(false)
  /// True when this currency is system-provided (cannot be deleted).
  system         Boolean  @default(false)
  /// Exchange rate × 10^8 against the account's base currency.
  rateValue      BigInt   @default(100000000) @map("rate_value")
  /// 'AUTO' (CBRU sync) | 'MANUAL'
  rateUpdateType String   @default("MANUAL") @map("rate_update_type") @db.VarChar(20)
  /// Multiplier for cross-currency math (rare; moysklad parity).
  multiplicity   Int      @default(1)
  /// Margin spread (% above/below CBRU rate when AUTO mode is on).
  margin         Decimal? @db.Decimal(5, 4)
  /// Major/minor unit names. Json: {"singular": "so'm", "plural": "so'm"}.
  majorUnit      Json?    @map("major_unit")
  minorUnit      Json?    @map("minor_unit")
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  defaultForSettings CompanySettings[]

  @@unique([accountId, code])
  @@map("currencies")
}

/// Unit of measure (Birlik). Pre-seeded per-account with the OKEI subset
/// commonly used in UZ ("шт", "кг", "л", "м", ...). Free-form `name` since
/// moysklad lets users add custom units (e.g. "метр погонный", "штук в
/// упаковке").
model Uom {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  ownerId      String?  @map("owner_id") @db.Uuid
  groupId      String?  @map("group_id") @db.Uuid
  name         String   @db.VarChar(100)
  /// OKEI / system code. moysklad uses 5-digit numeric strings for OKEI.
  code         String?  @db.VarChar(50)
  externalCode String?  @map("external_code") @db.VarChar(50)
  description  String?
  shared       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner   Employee? @relation("UomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group   Group?    @relation("UomGroup", fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([accountId, code])
  @@map("uoms")
}

/// VAT / tax rate lookup. UZ system rates: 0% / 12% / "Without VAT".
/// Per-account so each company can add custom rates (e.g. 15% for some
/// cross-border services).
model TaxRate {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  ownerId   String?  @map("owner_id") @db.Uuid
  groupId   String?  @map("group_id") @db.Uuid
  /// VAT rate as a decimal percentage (12.00 = 12%). Stored as decimal so
  /// fractional rates like 5.5% (some EAEU services) stay exact.
  rate      Decimal  @db.Decimal(5, 2)
  comment   String?
  shared    Boolean  @default(true)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner   Employee? @relation("TaxRateOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group   Group?    @relation("TaxRateGroup", fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([accountId, rate])
  @@map("tax_rates")
}

/// Expense item lookup. Account-level "Аренда" / "Реклама" / "Канцелярия"
/// strings used by CashOut.expenseItem and PaymentOut.expenseItem to tag
/// expenses for P&L roll-up. We currently store the value as a free-form
/// string on those docs; this model is the master list.
model ExpenseItem {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  name         String   @db.VarChar(100)
  code         String?  @db.VarChar(50)
  externalCode String?  @map("external_code") @db.VarChar(50)
  description  String?
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, code])
  @@map("expense_items")
}

/// Custom dictionary — a user-created lookup set. moysklad lets users
/// define new lookup tables ("Departments", "Project priorities", "Lead
/// sources") and link them as Custom Attributes on entities. Each
/// CustomEntity has a name + a CustomEntityValue[] table for its rows.
model CustomEntity {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  values  CustomEntityValue[]

  @@unique([accountId, name])
  @@map("custom_entities")
}

/// Single row of a CustomEntity dictionary.
model CustomEntityValue {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  customEntityId String   @map("custom_entity_id") @db.Uuid
  name           String   @db.VarChar(255)
  /// Display order in pickers
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  customEntity CustomEntity @relation(fields: [customEntityId], references: [id], onDelete: Cascade)

  @@index([accountId, customEntityId, position])
  @@map("custom_entity_values")
}

/// Project — work container that documents can be tagged against.
/// Used for cost-centre / department reporting on the per-document
/// `project` FK we've already added across most docs.
model Project {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  ownerId      String?  @map("owner_id") @db.Uuid
  groupId      String?  @map("group_id") @db.Uuid
  name         String   @db.VarChar(255)
  code         String?  @db.VarChar(50)
  externalCode String?  @map("external_code") @db.VarChar(50)
  description  String?
  shared       Boolean  @default(false)
  attributes   Json?    @default("{}")
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account                 Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner                   Employee?                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group                   Group?                   @relation("ProjectGroup", fields: [groupId], references: [id], onDelete: SetNull)
  customerOrders          CustomerOrder[]          @relation("CustomerOrderProject")
  demands                 Demand[]                 @relation("DemandProject")
  invoiceOuts             InvoiceOut[]             @relation("InvoiceOutProject")
  salesReturns            SalesReturn[]            @relation("SalesReturnProject")
  invoiceIns              InvoiceIn[]              @relation("InvoiceInProject")
  supplies                Supply[]                 @relation("SupplyProject")
  purchaseReturns         PurchaseReturn[]         @relation("PurchaseReturnProject")
  purchaseOrders          PurchaseOrder[]          @relation("PurchaseOrderProject")
  moves                   Move[]                   @relation("MoveProject")
  losses                  Loss[]                   @relation("LossProject")
  enters                  Enter[]                  @relation("EnterProject")
  inventories             Inventory[]              @relation("InventoryProject")
  internalOrders          InternalOrder[]          @relation("InternalOrderProject")
  cashIns                 CashIn[]                 @relation("CashInProject")
  cashOuts                CashOut[]                @relation("CashOutProject")
  paymentIns              PaymentIn[]              @relation("PaymentInProject")
  paymentOuts             PaymentOut[]             @relation("PaymentOutProject")
  prepayments             Prepayment[]             @relation("PrepaymentProject")
  prepaymentReturns       PrepaymentReturn[]       @relation("PrepaymentReturnProject")
  counterpartyAdjustments CounterpartyAdjustment[] @relation("CpAdjustmentProject")
  processingOrders        ProcessingOrder[]        @relation("ProcessingOrderProject")
  processings             Processing[]             @relation("ProcessingProject")
  productions             Production[]             @relation("ProductionProject")

  @@unique([accountId, code])
  @@index([accountId, archived])
  @@map("projects")
}

/// Per-user saved-filter pill that appears under a list page's
/// sub-nav. Mirrors moysklad's account-defined filter chips
/// (e.g. "ипадром", "Фаррухбек касса"). Each row stores a serialised
/// query-string + a friendly label; clicking the pill reapplies
/// the filter. Scoped per `(accountId, ownerId, entity)` so each
/// user sees only their own pills per list page.
model SavedFilter {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid

  /// e.g. "customerorder" / "demand" / "invoiceout".
  entity      String @db.VarChar(50)
  /// Human-readable pill label.
  name        String @db.VarChar(100)
  /// Serialised query string (without leading "?"). Reapplied verbatim.
  queryString String @map("query_string") @db.VarChar(2000)
  /// Display order — lower numbers render first. moysklad lets users drag-reorder.
  position    Int    @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner   Employee? @relation("SavedFilterOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([accountId, ownerId, entity])
  @@map("saved_filters")
}

/// Counterparty contract. Many UZ B2B agreements are renewed annually
/// and reference a frame contract; documents (invoices, supplies) link
/// to the active contract for downstream reporting + legal compliance.
model Contract {
  id                    String  @id @default(uuid()) @db.Uuid
  accountId             String  @map("account_id") @db.Uuid
  ownerId               String? @map("owner_id") @db.Uuid
  groupId               String? @map("group_id") @db.Uuid
  agentId               String  @map("agent_id") @db.Uuid // counterparty
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  ownAgentId            String  @map("own_agent_id") @db.Uuid // our organisation
  organizationAccountId String? @map("organization_account_id") @db.Uuid

  name         String   @db.VarChar(255)
  code         String?  @db.VarChar(50)
  externalCode String?  @map("external_code") @db.VarChar(50)
  description  String?
  /// 'Sales' | 'Commission'
  contractType String   @default("Sales") @map("contract_type") @db.VarChar(20)
  moment       DateTime @default(now()) @db.Timestamptz()

  /// Currency rate snapshot — Contract carries a Rate (currency + exchange
  /// rate × 10^8) just like documents do. moysklad parity.
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  /// Total amount of the contract (cap). Documents are reconciled against
  /// this — when sum(linked docs) approaches this, alerts fire.
  sumMinor BigInt @default(0) @map("sum_minor")

  /// Reward percent / type for commission contracts.
  rewardPercent Int?    @map("reward_percent")
  rewardType    String? @map("reward_type") @db.VarChar(30)

  shared     Boolean @default(false)
  printed    Boolean @default(false)
  published  Boolean @default(false)
  attributes Json?   @default("{}")
  archived   Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account                 Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner                   Employee?                @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group                   Group?                   @relation("ContractGroup", fields: [groupId], references: [id], onDelete: SetNull)
  agent                   Counterparty             @relation("ContractAgent", fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount            CounterpartyAccount?     @relation("ContractAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  ownAgent                Organization             @relation("ContractOwnAgent", fields: [ownAgentId], references: [id], onDelete: Restrict)
  organizationAccount     OrganizationAccount?     @relation("ContractOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  commReportOuts          CommissionReportOut[]    @relation("CommReportOutContract")
  commReportIns           CommissionReportIn[]     @relation("CommReportInContract")
  customerOrders          CustomerOrder[]          @relation("CustomerOrderContract")
  demands                 Demand[]                 @relation("DemandContract")
  invoiceOuts             InvoiceOut[]             @relation("InvoiceOutContract")
  salesReturns            SalesReturn[]            @relation("SalesReturnContract")
  invoiceIns              InvoiceIn[]              @relation("InvoiceInContract")
  supplies                Supply[]                 @relation("SupplyContract")
  purchaseReturns         PurchaseReturn[]         @relation("PurchaseReturnContract")
  purchaseOrders          PurchaseOrder[]          @relation("PurchaseOrderContract")
  cashIns                 CashIn[]                 @relation("CashInContract")
  cashOuts                CashOut[]                @relation("CashOutContract")
  paymentIns              PaymentIn[]              @relation("PaymentInContract")
  paymentOuts             PaymentOut[]             @relation("PaymentOutContract")
  prepayments             Prepayment[]             @relation("PrepaymentContract")
  prepaymentReturns       PrepaymentReturn[]       @relation("PrepaymentReturnContract")
  counterpartyAdjustments CounterpartyAdjustment[] @relation("CpAdjustmentContract")

  @@unique([accountId, name])
  @@index([accountId, agentId])
  @@index([accountId, archived])
  @@map("contracts")
}

/// Per-account global settings. Singleton — exactly one row per account.
/// Drives feature flags + defaults that show up across modules.
model CompanySettings {
  id                       String   @id @default(uuid()) @db.Uuid
  accountId                String   @unique @map("account_id") @db.Uuid
  // Sherset KEEP (debts messaging) — B3
  messagingPhone           String?  @map("messaging_phone") @db.VarChar(30)
  messagingCard            String?  @map("messaging_card") @db.VarChar(40)
  messagingCardOwner       String?  @map("messaging_card_owner") @db.VarChar(120)
  /// Two-letter country code for the account. Drives format defaults
  /// (date / number / phone). UZ for our clone.
  accountCountry           String   @default("UZ") @map("account_country") @db.VarChar(2)
  /// Default currency for new docs (FK to Currency).
  defaultCurrencyId        String?  @map("default_currency_id") @db.Uuid
  /// Use a single global numbering sequence vs per-org numbering.
  globalOperationNumbering Boolean  @default(false) @map("global_operation_numbering")
  /// Validate that documents don't sell below Product.minPrice.
  checkMinPrice            Boolean  @default(false) @map("check_min_price")
  /// Validate that shipments don't exceed available stock.
  checkShippingStock       Boolean  @default(true) @map("check_shipping_stock")
  /// Show recyclebin for soft-deleted docs (vs hard-delete).
  useRecycleBin            Boolean  @default(true) @map("use_recycle_bin")
  /// Display the company address on printed documents.
  useCompanyAddress        Boolean  @default(true) @map("use_company_address")
  companyAddress           String?  @map("company_address") @db.VarChar(255)
  /// Discount stack policy: BY_PRIORITY | BY_SUM | BY_PRODUCT
  discountStrategy         String   @default("BY_PRIORITY") @map("discount_strategy") @db.VarChar(30)
  /// moysklad «Обратный адрес в письмах»: EMPLOYEE (sender's address) | COMPANY.
  emailReplyMode           String   @default("EMPLOYEE") @map("email_reply_mode") @db.VarChar(20)
  /// moysklad «Использовать партии товаров».
  useConsignments          Boolean  @default(false) @map("use_consignments")
  /// moysklad «Включить отображение дополнительных полей товаров и услуг
  /// в позициях документов».
  showPositionAttributes   Boolean  @default(true) @map("show_position_attributes")
  /// Pre-defined sale price types referenced from products + price lists.
  /// JSON for moysklad parity (their schema exposes a list, not a relation).
  priceTypesJson           Json?    @map("price_types_json")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  /// Kassir cheki chiqadigan printer nomi (omborchi agenti o'qiydi).
  /// climart adoption o'chirgan; /sotuv «Rasmiylashtirish» oqimi bilan qaytdi.
  receiptPrinterName       String?  @map("receipt_printer_name") @db.VarChar(255)

  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  defaultCurrency Currency? @relation(fields: [defaultCurrencyId], references: [id], onDelete: SetNull)

  @@map("company_settings")
}

/// Per-employee preferences. Singleton — exactly one row per employee.
/// moysklad's "Мои настройки" page writes here.
model UserSettings {
  id                String   @id @default(uuid()) @db.Uuid
  employeeId        String   @unique @map("employee_id") @db.Uuid
  /// 'uz-Latn' | 'uz-Cyrl' | 'ru' | 'en'
  locale            String   @default("uz-Latn") @db.VarChar(10)
  /// 'A4' | 'A5' | 'THERMAL_80MM' | 'LETTER'
  printFormat       String   @default("A4") @map("print_format") @db.VarChar(20)
  /// 'HOMEPAGE' | 'CUSTOMER_ORDERS' | 'PRODUCTS' | 'CASHIER_FORM' | ...
  defaultScreen     String?  @map("default_screen") @db.VarChar(40)
  defaultCompanyId  String?  @map("default_company_id") @db.Uuid
  defaultStoreId    String?  @map("default_store_id") @db.Uuid
  defaultProjectId  String?  @map("default_project_id") @db.Uuid
  defaultCustomerId String?  @map("default_customer_id") @db.Uuid
  defaultSupplierId String?  @map("default_supplier_id") @db.Uuid
  /// Form layout density — number of fields shown per row in detail forms.
  fieldsPerRow      Int      @default(2) @map("fields_per_row")
  /// Show charts/numbers on the homepage when true.
  autoShowReports   Boolean  @default(true) @map("auto_show_reports")
  /// Append "Sent from MoySklad" footer on outgoing emails.
  mailFooter        Boolean  @default(true) @map("mail_footer")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Webhook subscription. Per-account; emits POST to `url` on the chosen
/// entity events (CREATE / UPDATE / DELETE). moysklad's standard
/// integration mechanism for 1C / partner sync.
model Webhook {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  /// 'product' | 'counterparty' | 'customerorder' | ...
  entityType  String   @map("entity_type") @db.VarChar(40)
  /// Comma-separated list of CREATE / UPDATE / DELETE.
  action      String   @db.VarChar(40)
  /// HMAC secret for request signing (X-Lognex-Signature header).
  secretHash  String?  @map("secret_hash") @db.VarChar(255)
  url         String   @db.VarChar(500)
  /// Extra metadata flags moysklad sends in the webhook payload.
  diffType    String?  @map("diff_type") @db.VarChar(20)
  enabled     Boolean  @default(true)
  authContext Json?    @map("auth_context")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([accountId, entityType, action, enabled])
  @@map("webhooks")
}

/// Persistent webhook delivery queue. Each row is one HTTP POST attempt
/// (or the next-pending future attempt) to a Webhook subscription. The
/// background WebhookDeliveryWorker picks up rows where status='pending'
/// and nextRetryAt <= NOW(), POSTs the payload, then either marks 'sent'
/// or schedules the next retry. After 5 failed attempts the row goes to
/// status='dead' (Dead Letter Queue) for manual inspection.
///
/// Backoff schedule mirrors moysklad official spec:
///   attempt 1 (immediate)
///   attempt 2 (+1m)
///   attempt 3 (+5m)
///   attempt 4 (+30m)
///   attempt 5 (+1h)
///   attempt 6 (+6h) — final, then 'dead'
model WebhookDelivery {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  webhookId   String    @map("webhook_id") @db.Uuid
  /// JSON payload as moysklad-spec POST body: { events: [...], auditContext }.
  /// Stored once at enqueue time; replayed verbatim on each retry so HMAC
  /// signature stays consistent across attempts.
  payload     Json
  /// 'pending' | 'sent' | 'failed' | 'dead'
  /// pending = waiting for worker (or next retry)
  /// sent    = HTTP 2xx received
  /// failed  = transient — non-2xx or network error, will retry
  /// dead    = exhausted all retries, manual review needed
  status      String    @db.VarChar(20)
  /// 1-based attempt counter. 1 = first try, 6 = last try before 'dead'.
  attempt     Int       @default(1)
  maxAttempts Int       @default(6) @map("max_attempts")
  /// HTTP status code from the most recent attempt (null if never attempted yet).
  httpStatus  Int?      @map("http_status")
  /// Error message or response body snippet (truncated to 500 chars).
  errorMsg    String?   @map("error_msg")
  /// When this delivery should be picked up by the worker. Set to NOW() on
  /// enqueue; bumped to future time after each failed attempt.
  nextRetryAt DateTime  @map("next_retry_at") @db.Timestamptz()
  /// Most recent attempt timestamp (null if never attempted yet).
  attemptedAt DateTime? @map("attempted_at") @db.Timestamptz()
  /// Set when status moves to 'sent'.
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  /// Hot-path index for the worker: pick pending rows due now, oldest first.
  @@index([status, nextRetryAt])
  /// Per-webhook history view (admin UI).
  @@index([webhookId, createdAt(sort: Desc)])
  /// Per-account delivery search.
  @@index([accountId, status, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

/// Webhook subscription specific to stock-movement events. moysklad
/// exposes this as a separate entity from regular Webhook because the
/// payload shape differs (per-product, per-store stock deltas) and rate
/// limits are different.
model WebhookStock {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  /// 'STOCK' | 'RESERVE' | 'IN_TRANSIT' — which counter to subscribe to.
  stockType  String   @map("stock_type") @db.VarChar(20)
  /// 'BY_PRODUCT' | 'BY_STORE' | 'COMBINED'
  reportType String   @map("report_type") @db.VarChar(30)
  reportUrl  String   @map("report_url") @db.VarChar(500)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, enabled])
  @@map("webhook_stocks")
}

/// FIFO consignment / batch lot. moysklad's Consignment is a tracked
/// batch of a product (e.g. one specific shipment of bottles with
/// expiry 2027-04-01). Documents reference Consignment via assortment,
/// stock counters track it separately from product-level totals.
model Consignment {
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  variantId    String?   @map("variant_id") @db.Uuid
  /// Batch label printed on box / barcode label.
  label        String    @db.VarChar(255)
  /// Display name = "{product.name} / batch {label}"
  name         String    @db.VarChar(500)
  code         String?   @db.VarChar(50)
  externalCode String?   @map("external_code") @db.VarChar(50)
  description  String?
  /// Expiry / best-before. Drives FEFO (first-expiring first-out)
  /// allocation for perishable goods.
  expiryDate   DateTime? @map("expiry_date") @db.Date
  barcodes     String[]  @default([])
  attributes   Json?     @default("{}")
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product Product  @relation("ProductConsignment", fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation("VariantConsignment", fields: [variantId], references: [id], onDelete: Cascade)

  @@index([accountId, productId])
  @@index([accountId, variantId])
  @@index([accountId, expiryDate])
  @@map("consignments")
}

/// Bonus / loyalty operation. Records every accrual or redemption against
/// a Counterparty's bonusPoints counter. Each row links to the BonusProgram
/// that emitted it + the source document that triggered the change.
model BonusOperation {
  id             String  @id @default(uuid()) @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  ownerId        String? @map("owner_id") @db.Uuid
  groupId        String? @map("group_id") @db.Uuid
  agentId        String  @map("agent_id") @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  bonusProgramId String? @map("bonus_program_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  description  String?

  /// EARNING (accrual) | SPENDING (redemption)
  transactionType   String  @map("transaction_type") @db.VarChar(20)
  /// REGULAR | WELCOME | RETURN | EXPIRED
  categoryType      String? @map("category_type") @db.VarChar(20)
  /// COMMITTED | PENDING | CANCELLED
  transactionStatus String  @default("COMMITTED") @map("transaction_status") @db.VarChar(20)
  /// Number of bonus points debited / credited (signed).
  bonusValue        Int

  moment        DateTime  @default(now()) @db.Timestamptz()
  /// When the bonus was actually applied to the agent's balance (lag for
  /// PENDING accruals — moysklad has this delay so returns can claw back).
  executionDate DateTime? @map("execution_date") @db.Timestamptz()
  applicable    Boolean   @default(false)

  /// Source document (RetailSale / Demand / etc) — polymorphic link.
  parentEntity String? @map("parent_entity") @db.VarChar(40)
  parentId     String? @map("parent_id") @db.Uuid

  shared Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?     @relation("BonusOpOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?        @relation("BonusOpGroup", fields: [groupId], references: [id], onDelete: SetNull)
  agent        Counterparty  @relation("BonusOpAgent", fields: [agentId], references: [id], onDelete: Restrict)
  organization Organization? @relation("BonusOpOrg", fields: [organizationId], references: [id], onDelete: SetNull)
  bonusProgram BonusProgram? @relation("BonusOpProgram", fields: [bonusProgramId], references: [id], onDelete: SetNull)

  @@unique([accountId, name])
  @@index([accountId, agentId, moment(sort: Desc)])
  @@index([accountId, transactionStatus])
  @@map("bonus_operations")
}

/// Discount rule. moysklad models discounts as a polymorphic entity
/// covering: per-product discount, per-counterparty discount, accumulative,
/// special date-range, personal. We store the kind discriminator and a
/// rules JSON for the variant-specific shape.
model Discount {
  id                   String   @id @default(uuid()) @db.Uuid
  accountId            String   @map("account_id") @db.Uuid
  name                 String   @db.VarChar(255)
  /// 'special' | 'accumulative' | 'personal' | 'product' | 'agent'
  kind                 String   @db.VarChar(30)
  active               Boolean  @default(true)
  allAgents            Boolean  @default(true) @map("all_agents")
  allProducts          Boolean  @default(true) @map("all_products")
  agentTags            String[] @default([]) @map("agent_tags")
  /// Variant-specific rules. e.g. accumulative: { tiers: [{from, percent}] }
  rules                Json?
  // Loyalty / bonus program rates (live API exposes these on Discount —
  // moysklad's Discount entity unions discount rules + bonus program).
  /// How many sum (or rouble in RU) buys 1 bonus point.
  earnRateUzsToPoint   Decimal? @map("earn_rate_uzs_to_point") @db.Decimal(15, 2)
  /// Inverse — points → sum value when redeeming.
  spendRatePointsToUzs Decimal? @map("spend_rate_points_to_uzs") @db.Decimal(15, 2)
  /// Cap on % of a sale that bonuses can cover (0-100).
  maxPaidRatePercents  Int?     @map("max_paid_rate_percents")
  /// True = earn bonuses while spending bonuses on the same sale.
  earnWhileRedeeming   Boolean  @default(false) @map("earn_while_redeeming")
  archived             Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version              Int      @default(1)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name])
  @@map("discounts")
}

/// Marking / serial code (ASL Belgisi для UZ; Honest Sign in RU). Tracks
/// individual codes scanned during sales / receipts for traceable goods
/// (footwear, tobacco, perfume, ...).
model TrackingCode {
  id            String   @id @default(uuid()) @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  /// The actual marking code (DataMatrix / GTIN+serial+CRC).
  cis           String   @db.VarChar(255)
  /// CIS_1162 — Russian fiscal flag variant (kept for moysklad parity).
  cis1162       String?  @map("cis_1162") @db.VarChar(255)
  /// SHOES | TOBACCO | MEDICINES | PERFUME | TIRES | DAIRY | ...
  type          String   @db.VarChar(30)
  /// Status: ACTIVE | RETIRED | TRANSFERRED
  status        String   @default("ACTIVE") @db.VarChar(20)
  productId     String?  @map("product_id") @db.Uuid
  variantId     String?  @map("variant_id") @db.Uuid
  /// JSON: aggregated codes (parent box → children units).
  trackingCodes Json?    @map("tracking_codes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, cis])
  @@index([accountId, type, status])
  @@map("tracking_codes")
}

// =========================================================================
// Documents — additional moysklad doc types
// =========================================================================

/// Prepayment (Предоплата) — money received before the corresponding
/// invoice/order is closed. Customer-context counterpart of an advance
/// payment. Linked back to a CustomerOrder to reduce its outstanding sum.
model Prepayment {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  agentId               String  @map("agent_id") @db.Uuid
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  customerOrderId       String? @map("customer_order_id") @db.Uuid
  retailShiftId         String? @map("retail_shift_id") @db.Uuid
  retailStoreId         String? @map("retail_store_id") @db.Uuid
  // moysklad parity — Договор / Проект (advance has counterparty).
  contractId            String? @map("contract_id") @db.Uuid
  projectId             String? @map("project_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor       BigInt @default(0) @map("sum_minor")
  vatSumMinor    BigInt @default(0) @map("vat_sum_minor")
  /// Total of cash component (when paid through retail till).
  cashSumMinor   BigInt @default(0) @map("cash_sum_minor")
  noCashSumMinor BigInt @default(0) @map("no_cash_sum_minor")
  qrSumMinor     BigInt @default(0) @map("qr_sum_minor")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")
  /// Per-doc tax-system override (USN / OSN / ...).
  taxSystem   String? @map("tax_system") @db.VarChar(30)

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?            @relation("PrepaymentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group               Group?               @relation("PrepaymentGroup", fields: [groupId], references: [id], onDelete: SetNull)
  agent               Counterparty         @relation("PrepaymentAgent", fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount        CounterpartyAccount? @relation("PrepaymentAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization        Organization         @relation("PrepaymentOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount? @relation("PrepaymentOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  customerOrder       CustomerOrder?       @relation("PrepaymentCustomerOrder", fields: [customerOrderId], references: [id], onDelete: SetNull)
  contract            Contract?            @relation("PrepaymentContract", fields: [contractId], references: [id], onDelete: SetNull)
  project             Project?             @relation("PrepaymentProject", fields: [projectId], references: [id], onDelete: SetNull)
  returns             PrepaymentReturn[]   @relation("PrepaymentReturnSource")

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, customerOrderId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("prepayments")
}

/// Refund of a Prepayment. State machine and money math mirrors Prepayment.
model PrepaymentReturn {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  agentId               String  @map("agent_id") @db.Uuid
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  prepaymentId          String  @map("prepayment_id") @db.Uuid
  retailShiftId         String? @map("retail_shift_id") @db.Uuid
  retailStoreId         String? @map("retail_store_id") @db.Uuid
  // moysklad parity — Договор / Проект (advance refund has counterparty).
  contractId            String? @map("contract_id") @db.Uuid
  projectId             String? @map("project_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor       BigInt @default(0) @map("sum_minor")
  vatSumMinor    BigInt @default(0) @map("vat_sum_minor")
  cashSumMinor   BigInt @default(0) @map("cash_sum_minor")
  noCashSumMinor BigInt @default(0) @map("no_cash_sum_minor")
  qrSumMinor     BigInt @default(0) @map("qr_sum_minor")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")
  taxSystem   String? @map("tax_system") @db.VarChar(30)

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?            @relation("PrepayReturnOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group               Group?               @relation("PrepayReturnGroup", fields: [groupId], references: [id], onDelete: SetNull)
  agent               Counterparty         @relation("PrepayReturnAgent", fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount        CounterpartyAccount? @relation("PrepayReturnAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization        Organization         @relation("PrepayReturnOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount? @relation("PrepayReturnOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  prepayment          Prepayment           @relation("PrepaymentReturnSource", fields: [prepaymentId], references: [id], onDelete: Restrict)
