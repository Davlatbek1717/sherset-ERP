// === HR TimePay davomat yadrosi (Bo'lim / Lavozim / Jadval / multi-branch) ===
// TZ: docs/superpowers/specs/2026-07-24-hr-timepay-attendance-core-design.md §4.
// Additive-only, account-scoped, soft-delete via `archived` (mirror HrWorkLocation).

/// Bo'lim (TimePay "Bo'lim"). Name only; assigned 1:many to employees.
model HrDepartment {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  name      String   @db.VarChar(150)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employees Employee[] @relation("EmployeeDepartment")

  @@index([accountId, archived])
  @@map("hr_departments")
}

/// Lavozim (TimePay "Lavozim"). Name only; assigned 1:many to employees.
/// Distinct from the legacy free-text Employee.position VarChar (kept for back-compat).
model HrPosition {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  name      String   @db.VarChar(150)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employees Employee[] @relation("EmployeePosition")

  @@index([accountId, archived])
  @@map("hr_positions")
}

/// Ish jadvali (TimePay "Ish jadvali"). Cycle-based schedule template.
/// type: 'flexible' (Moslashuvchan) | 'free' (Erkin) — VarChar+comment,
/// mirrors HrAttendance.source VarChar(12) 'auto_gps'|'manual'.
model HrSchedule {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  name            String   @db.VarChar(150)
  type            String   @default("flexible") @db.VarChar(12) // 'flexible' | 'free'
  startDate       DateTime @map("start_date") @db.Date // cycle anchor, Asia/Tashkent calendar date (DATE not Timestamptz)
  cycleDays       Int      @map("cycle_days") // Sikl (1..N)
  calcOvertime    Boolean  @default(false) @map("calc_overtime") // "Qo'shimcha ish vaqtini hisoblash"
  extendedWorkMin Int      @default(0) @map("extended_work_min") // "Uzaytirilgan ish vaqti", minutes
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account   Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  days      HrScheduleDay[]
  employees Employee[]      @relation("EmployeeSchedule2")

  @@index([accountId, archived])
  @@map("hr_schedules")
}

/// One row per cycle day (TimePay "Kun N" grid). dayIndex 1..cycleDays.
/// Times as "HH:mm" VarChar(5), mirroring EmployeeWorkSchedule.
/// break/times nullable so a day-off (isWorkday=false) can omit them.
model HrScheduleDay {
  id         String  @id @default(uuid()) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  scheduleId String  @map("schedule_id") @db.Uuid
  dayIndex   Int     @map("day_index") // 1..cycleDays
  isWorkday  Boolean @default(true) @map("is_workday") // "Ish kuni"
  startTime  String? @map("start_time") @db.VarChar(5) // "09:00"
  endTime    String? @map("end_time") @db.VarChar(5) // "18:00"
  breakStart String? @map("break_start") @db.VarChar(5) // "13:00"
  breakEnd   String? @map("break_end") @db.VarChar(5) // "14:00"

  account  Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  schedule HrSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dayIndex])
  @@index([accountId, scheduleId])
  @@map("hr_schedule_days")
}

/// Employee ↔ Branch (HrWorkLocation) many-to-many join. Composite PK.
/// Employee.workLocationId stays as the primary/default branch (back-compat);
/// this join holds the full assigned set (TimePay multi-branch).
model HrEmployeeBranch {
  accountId      String   @map("account_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  workLocationId String   @map("work_location_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee     Employee       @relation("EmployeeBranches", fields: [employeeId], references: [id], onDelete: Cascade)
  workLocation HrWorkLocation @relation("BranchEmployees", fields: [workLocationId], references: [id], onDelete: Cascade)

  @@id([employeeId, workLocationId])
  @@index([accountId, workLocationId])
  @@map("hr_employee_branches")
}

// =====================================================================
// Analitika module — bolt-on analytics/inventory-counting domain.
// Additive-only: plain scalar UUID columns (no @relation to core tables)
// so migrations never ALTER existing tables. Referential integrity is
// enforced at the application layer. "expectedQty" snapshots Stock at
// count time ("REGOS qoldig'i" in the spec = local stock).
// =====================================================================

model AnalitikaCount {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  expectedQty    Decimal   @map("expected_qty") @db.Decimal(20, 6)
  kamQty         Decimal   @default(0) @map("kam_qty") @db.Decimal(20, 6)
  kopQty         Decimal   @default(0) @map("kop_qty") @db.Decimal(20, 6)
  netQty         Decimal   @map("net_qty") @db.Decimal(20, 6)
  salePriceMinor BigInt    @map("sale_price_minor")
  status         String    @db.VarChar(10) // green | yellow | red
  decision       String?   @db.VarChar(12) // accepted | rejected | null
  counterId      String    @map("counter_id") @db.Uuid
  countedAt      DateTime  @default(now()) @map("counted_at") @db.Timestamptz()
  reviewerId     String?   @map("reviewer_id") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz()
  reasonCodeId   String?   @map("reason_code_id") @db.Uuid
  note           String?

  @@unique([accountId, productId, storeId])
  @@index([accountId, status, countedAt(sort: Desc)])
  @@index([accountId, counterId])
  @@map("analitika_counts")
}

model AnalitikaReasonCode {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  label     String  @db.VarChar(100)
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([accountId, label])
  @@index([accountId, active])
  @@map("analitika_reason_codes")
}

model AnalitikaVarianceConfig {
  id           String  @id @default(uuid()) @db.Uuid
  accountId    String  @unique @map("account_id") @db.Uuid
  greenMaxPct  Decimal @default(5) @map("green_max_pct") @db.Decimal(6, 2)
  yellowMaxPct Decimal @default(15) @map("yellow_max_pct") @db.Decimal(6, 2)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("analitika_variance_configs")
}

model AnalitikaOrder {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  number         String   @db.VarChar(40)
  counterpartyId String?  @map("counterparty_id") @db.Uuid
  state          String   @default("formed") @db.VarChar(20) // draft | formed | done
  totalMinor     BigInt   @default(0) @map("total_minor")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  lines AnalitikaOrderLine[]

  @@unique([accountId, number])
  @@index([accountId, createdAt(sort: Desc)])
  @@map("analitika_orders")
}

model AnalitikaOrderLine {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  qty        Decimal @db.Decimal(20, 6)
  priceMinor BigInt  @map("price_minor")
  sumMinor   BigInt  @map("sum_minor")

  order AnalitikaOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([accountId, productId])
  @@map("analitika_order_lines")
}

/// moysklad «Привязать документ» — a MANUAL association between two documents,
/// shown in the «Связанные документы» tab (the auto-linked FK chain is computed
/// separately per doc). Polymorphic: {source,target}Type is the PascalCase model
/// name. Each row also snapshots both endpoints' display fields (name/date/sum/
/// state) captured at link time, so the related panel renders each linked card
/// without a cross-model resolution map. A link is bidirectional: querying by
/// either endpoint returns the OTHER endpoint's snapshot.
model DocumentLink {
  id         String @id @default(uuid()) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  sourceType String @map("source_type") @db.VarChar(64)
  sourceId   String @map("source_id") @db.Uuid
  targetType String @map("target_type") @db.VarChar(64)
  targetId   String @map("target_id") @db.Uuid

  sourceName     String   @map("source_name") @db.VarChar(255)
  sourceMoment   DateTime @map("source_moment") @db.Timestamptz()
  sourceSumMinor BigInt   @map("source_sum_minor")
  sourceState    String   @default("draft") @map("source_state") @db.VarChar(32)
  targetName     String   @map("target_name") @db.VarChar(255)
  targetMoment   DateTime @map("target_moment") @db.Timestamptz()
  targetSumMinor BigInt   @map("target_sum_minor")
  targetState    String   @default("draft") @map("target_state") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([accountId, sourceType, sourceId, targetType, targetId], name: "document_links_unique")
  @@index([accountId, sourceType, sourceId])
  @@index([accountId, targetType, targetId])
  @@map("document_links")
}

// ===== Sherset KEEP: Debt models (climart sxemasida yo'q — qo'shildi B2) =====
/// Mijozga berilgan qarz. `paidMinor` — barcha to'lovlar yig'indisi
/// (denormalizatsiya: ro'yxat/saralash tez ishlashi uchun; yagona haqiqat
/// manbai `debt_payments` — DebtService har yozuvdan keyin qayta hisoblaydi).
model Debt {
  id             String @id @default(uuid()) @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  counterpartyId String @map("counterparty_id") @db.Uuid

  /// Avto-raqam: QRZ-YYYY-NNNNN (document_sequences orqali, race-safe).
  name String @db.VarChar(50)

  /// Umumiy qarz summasi (tiyin).
  totalMinor BigInt @map("total_minor")
  /// To'langan summa (tiyin) — payments yig'indisi.
  paidMinor  BigInt @default(0) @map("paid_minor")
  currency   String @default("UZS") @db.VarChar(3)

  /// TZ §4: 'unpaid' | 'partial' | 'paid'. `paid` ⇒ qarzdorlar ro'yxatidan chiqadi.
  status String @default("unpaid") @db.VarChar(20)

  /// TZ §3.3 — qarz berishda MAJBURIY: keyingi qo'ng'iroq/to'lov vaqti.
  /// Qarz to'liq yopilganda (§3.6) endi kerak emas ⇒ null'ga tushadi.
  nextContactAt DateTime? @map("next_contact_at") @db.Timestamptz()

  /// Oxirgi qo'ng'iroq belgisi (2026-07-12 talab): operator «qo'ng'iroq qilindi»
  /// deb saqlaganda to'ladi. Outcome — suhbat natijasi:
  /// 'paid_full' | 'paid_partial' | 'not_paid' | 'callback'.
  /// «Qo'ng'iroq qilinganlar» bo'limi shu maydonlardan filtrlanadi.
  lastCallAt      DateTime? @map("last_call_at") @db.Timestamptz()
  lastCallOutcome String?   @map("last_call_outcome") @db.VarChar(20)
  /// Eslatma-cron dedup belgisi: nextContactAt uchun bildirishnoma yuborilgan
  /// payt. Yangi nextContactAt qo'yilganda NULL'ga tushadi — keyingi muddat
  /// uchun eslatma qayta ishlaydi.
  callRemindedAt  DateTime? @map("call_reminded_at") @db.Timestamptz()

  /// 15-KUNLIK MIJOZGA TAKROR TELEGRAM ESLATMASI (2026-07-16 talab) dedup belgisi:
  /// mijozning O'ZIGA «qarzingiz bor» avtomatik eslatmasi oxirgi yuborilgan payt.
  /// Operatorning qo'ng'iroq jadvalidan (nextContactAt/callRemindedAt) ALOHIDA —
  /// bunga tegmaydi. null ⇒ hali yuborilmagan (birinchi eslatma createdAt'dan
  /// N kun o'tgach ketadi). Cron: har kuni, qarz qolgan bo'lsa har N kunda takror.
  lastTgReminderAt DateTime? @map("last_tg_reminder_at") @db.Timestamptz()

  /// MUAMMOLI MIJOZ (2026-07-14 talab). Operator qo'ng'iroq natijasini
  /// belgilaganda mijozni «muammoli» deb ajratib qo'yishi mumkin: telefonni
  /// ko'tarmaydi, va'da berib bermaydi, janjal qiladi va h.k.
  ///
  /// Bu `lastCallOutcome` dan ALOHIDA o'q: mijoz «qisman to'ladi» bo'lib ham,
  /// ayni paytda muammoli bo'lishi mumkin. Shuning uchun alohida bayroq.
  ///   problem       — «Muammoli qarzdorlar» bo'limi shundan filtrlanadi
  ///   problemReason — NIMA muammo (majburiy: sababsiz belgi foydasiz)
  ///   problemAt / problemById — qachon va kim belgilagan
  /// Muammo hal bo'lsa `problem=false` bo'ladi, lekin sabab MULOQOT TARIXIDA
  /// qoladi — kim, qachon, nega degani yo'qolmasin.
  problem       Boolean   @default(false)
  problemReason String?   @map("problem_reason")
  problemAt     DateTime? @map("problem_at") @db.Timestamptz()
  problemById   String?   @map("problem_by_id") @db.Uuid

  /// Mas'ul xodim (call-markaz operatori) — ro'yxat filtri.
  ownerId    String? @map("owner_id") @db.Uuid
  /// Qarzni bergan kassir — §3.9 kunlik kassir hisoboti shu ustundan yig'iladi.
  issuedById String? @map("issued_by_id") @db.Uuid

  comment String?

  closedAt  DateTime? @map("closed_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  /// Soft-delete — korzina parity (hech qachon jismonan o'chmaydi).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty Counterparty  @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  owner        Employee?     @relation("DebtOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  issuedBy     Employee?     @relation("DebtIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  payments     DebtPayment[]
  notes        DebtNote[]

  @@unique([accountId, name])
  /// «Qarzdorlar ro'yxati» (§3.1) — status bo'yicha faol qarzlar.
  @@index([accountId, status, nextContactAt])
  /// «Bugungi qo'ng'iroqlar» (§3.5) — sana bo'yicha tanlash.
  @@index([accountId, nextContactAt])
  /// «Qo'ng'iroq qilinganlar» — kun kesimida tez tanlash.
  @@index([accountId, lastCallAt])
  @@index([accountId, counterpartyId])
  @@index([accountId, ownerId])
  @@index([accountId, issuedById, createdAt])
  @@map("debts")
}

/// Qarz bo'yicha to'lov. Uch kanal (TZ §3.6 + §3.7):
///   'cash'            — kassada naqd            (kassir)
///   'terminal'        — kassada terminal/karta  (kassir)
///   'card_screenshot' — mijoz kartadan o'tkazdi, chek rasmi (operator)
/// §3.9: kassir hisobotiga faqat cash+terminal kiradi; card_screenshot
/// operator hisobotida ko'rinadi — shuning uchun `method` ustuni ajratuvchi.
model DebtPayment {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  debtId    String @map("debt_id") @db.Uuid

  amountMinor BigInt @map("amount_minor")
  method      String @db.VarChar(20)

  /// §3.8 — «qayerdan qabul qilingani»: kassa nomi yoki «Karta — screenshot».
  sourceName String? @map("source_name") @db.VarChar(120)
  cashDeskId String? @map("cash_desk_id") @db.Uuid

  /// §3.7 — chek rasmi. `attachments.id` (entity='debtpayment'). FK EMAS:
  /// attachment polimorf jadval, Prisma relation'i yo'q — id sifatida saqlanadi.
  attachmentId String? @map("attachment_id") @db.Uuid

  /// To'lov VALYUTASI (2026-07-13): mijoz naqdni so'mda ham, dollarda ham
  /// berishi mumkin. `amountMinor` HAR DOIM qarz valyutasida (so'm/tiyin) —
  /// qarz hisobi shundan yuritiladi. Quyidagi uchlik esa ASL to'lovni saqlaydi:
  ///   currency            — 'UZS' | 'USD'
  ///   amountOriginalMinor — asl valyutadagi summa (USD → sent)
  ///   exchangeRate        — kurs ×10000 (masalan 12 800,50 so'm → 128005000)
  /// UZS to'lovda: currency='UZS', original=amountMinor, rate=null.
  currency            String  @default("UZS") @db.VarChar(3)
  amountOriginalMinor BigInt? @map("amount_original_minor")
  exchangeRate        BigInt? @map("exchange_rate")

  comment String?

  receivedById   String? @map("received_by_id") @db.Uuid
  /// 'cashier' | 'operator' — kim kiritgani (hisobotlarni ajratish uchun).
  receivedByRole String  @default("cashier") @map("received_by_role") @db.VarChar(20)

  /// TO'LOVNI QAYTARISH — storno (2026-07-16). Xato kiritilgan to'lov
  /// JISMONAN O'CHIRILMAYDI (tarix — dalil): reversed_at belgilanadi.
  /// reversed_at != NULL bo'lgan to'lov paidMinor yig'indisiga, kontragent
  /// balansiga va hisobotlarga KIRMAYDI, lekin ro'yxatlarda «qaytarilgan»
  /// belgisi bilan ko'rinadi — kim, qachon, nega qaytargani bilan.
  reversedAt    DateTime? @map("reversed_at") @db.Timestamptz()
  reversedById  String?   @map("reversed_by_id") @db.Uuid
  reverseReason String?   @map("reverse_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debt       Debt       @relation(fields: [debtId], references: [id], onDelete: Cascade)
  cashDesk   CashDesk?  @relation(fields: [cashDeskId], references: [id], onDelete: SetNull)
  receivedBy Employee?  @relation("DebtPaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  reversedBy Employee?  @relation("DebtPaymentReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  /// Shu to'lovni yaratgan qo'ng'iroq-yozuv(lar)i (2026-07-16 — natija↔to'lov bog'lami).
  notes      DebtNote[] @relation("DebtNotePayment")

  @@index([accountId, debtId, createdAt(sort: Desc)])
  /// §3.9 kunlik kassir hisoboti — (kassir, kun) kesimi.
  @@index([accountId, receivedById, createdAt])
  @@index([accountId, method, createdAt])
  @@map("debt_payments")
}

/// Mijoz bilan muloqot tarixi (TZ §3.4). Hech qachon o'chirilmaydi/ustidan
/// yozilmaydi — append-only. `nextContactAt` shu yozuvda kelishilgan keyingi
/// aloqa vaqti; DebtService uni Debt.nextContactAt'ga ko'chiradi (oxirgisi kuchda).
model DebtNote {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  debtId    String @map("debt_id") @db.Uuid

  text          String
  nextContactAt DateTime? @map("next_contact_at") @db.Timestamptz()

  /// Qo'ng'iroq NATIJASI (kind='call' yozuvlarda, 2026-07-12):
  /// 'paid_full' | 'paid_partial' | 'not_paid' | 'callback' | null (oddiy izoh).
  outcome String? @db.VarChar(20)

  /// Shu qo'ng'iroqda YARATILGAN to'lov (2026-07-16 — natijani BEKOR QILISH).
  /// paid_full/paid_partial natija to'lov yozuvi ochadi; bog'lam orqali natija
  /// bekor qilinganda to'lov ham storno bo'ladi (va aksincha), lastCallOutcome
  /// esa qolgan JONLI yozuvlardan deterministik qayta hisoblanadi.
  paymentId String? @map("payment_id") @db.Uuid

  /// NATIJANI BEKOR QILISH (2026-07-16): yozuv O'CHMAYDI — belgilanadi.
  /// canceled_at != NULL yozuv lastCallOutcome hisobiga KIRMAYDI, tarixda
  /// «bekor qilingan» ko'rinishida qoladi (kim, qachon, nega).
  canceledAt   DateTime? @map("canceled_at") @db.Timestamptz()
  canceledById String?   @map("canceled_by_id") @db.Uuid
  cancelReason String?   @map("cancel_reason")

  authorId   String? @map("author_id") @db.Uuid
  /// 'operator' | 'cashier' | 'admin' — §3.4: yozuvda rol ko'rsatiladi.
  authorRole String  @default("operator") @map("author_role") @db.VarChar(20)
  /// Manba: 'call' (operator suhbati) | 'debt_issue' (§3.3) | 'payment' (§3.6 qisman).
  kind       String  @default("call") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debt       Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  author     Employee?    @relation("DebtNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  payment    DebtPayment? @relation("DebtNotePayment", fields: [paymentId], references: [id], onDelete: SetNull)
  canceledBy Employee?    @relation("DebtNoteCanceler", fields: [canceledById], references: [id], onDelete: SetNull)

  @@index([accountId, debtId, createdAt(sort: Desc)])
  @@index([accountId, authorId, createdAt])
  @@map("debt_notes")
}

// ===== Sherset KEEP: Telegram chat/backfill models (B3 closure) =====
model TelegramChat {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Telegram chat id (client's private chat with the owner).
  chatId    BigInt  @map("chat_id")
  firstName String? @map("first_name") @db.VarChar(128)
  lastName  String? @map("last_name") @db.VarChar(128)
  username  String? @db.VarChar(64)

  /// Mijoz botga kontaktini ulashsa — telefon shu yerga tushadi va kontragent
  /// AVTOMATIK topiladi. Telegram Business xabarlarida telefon kelmaydi,
  /// shuning uchun u yerda ISM bo'yicha avtomatik taklif qilinadi.
  phone String? @db.VarChar(32)

  counterpartyId String? @map("counterparty_id") @db.Uuid
  /// Kontragent avtomatik topildimi (ism/telefon bo'yicha) yoki qo'lda bog'landimi.
  boundBy        String? @map("bound_by") @db.VarChar(10) // 'auto' | 'manual'

  /// Chat qayerdan keldi — xabar YUBORISH usuli shunga bog'liq:
  ///   'business' — egasining shaxsiy Telegram'i orqali (business_connection_id
  ///                bilan yuboriladi, mijoz egasining NOMIDAN xabar oladi)
  ///   'bot'      — mijoz botga o'zi yozgan (oddiy sendMessage)
  /// Noto'g'ri usul bilan yuborilsa Telegram xato qaytaradi, shuning uchun
  /// buni saqlab qo'yamiz.
  source String @default("business") @db.VarChar(10)

  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  /// Backfill/sync kursorlari (2026-07-20 to'liq-tarix). historyOldestId —
  /// backfill'da yetilgan eng eski tgMessageId (orqaga sahifalash offsetId'si);
  /// historyComplete — dialog boshiga yetildi; syncNewestId — catch-up uchun
  /// eng yangi ma'lum tgMessageId (minId).
  historyOldestId BigInt? @map("history_oldest_id")
  historyComplete Boolean @default(false) @map("history_complete")
  syncNewestId    BigInt? @map("sync_newest_id")

  account      Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty Counterparty?         @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  messages     TelegramChatMessage[]

  @@unique([accountId, chatId])
  @@index([accountId, counterpartyId])
  @@index([accountId, lastMessageAt(sort: Desc)])
  @@map("telegram_chats")
}

/// One message in a Telegram Business chat (both directions).
model TelegramChatMessage {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  chatRefId String @map("chat_ref_id") @db.Uuid

  /// 'in' = client wrote us; 'out' = sent from the owner's name.
  direction   String  @db.VarChar(3)
  text        String  @db.VarChar(4096)
  tgMessageId BigInt? @map("tg_message_id")
  senderName  String? @map("sender_name") @db.VarChar(128)

  /// MEDIA (2026-07-13): mijoz CHEK rasmini yuborganda ko'rinishi shart.
  /// Ilgari media'li xabar butunlay tashlab yuborilardi ("skip in V1") — chek
  /// yo'qolardi. Endi fayl Telegram'dan yuklab olinib, mavjud `attachments`
  /// jadvaliga yoziladi va chatda rasm bo'lib chiqadi.
  ///   kind       — 'text' | 'photo' | 'document' | 'voice' | 'video' | 'other'
  ///   fileId     — Telegram file_id (qayta yuklab olish uchun)
  ///   attachment — bizdagi nusxasi (yo'qolmasin: Telegram file_id muddatli)
  kind         String  @default("text") @db.VarChar(16)
  fileId       String? @map("file_id") @db.VarChar(200)
  fileName     String? @map("file_name") @db.VarChar(255)
  mimeType     String? @map("mime_type") @db.VarChar(100)
  attachmentId String? @map("attachment_id") @db.Uuid

  /// Avtomatik xabar bo'lsa — sababi ('debt_issued' | 'payment' | 'debt_closed'
  /// | 'reminder'). Qo'lda yozilgan xabarda null. Chatda belgisi ko'rinadi.
  autoKind String? @map("auto_kind") @db.VarChar(20)

  /// Forward qilingan xabaning asl jo'natuvchisi/kanal nomi (2026-07-20,
  /// Phase 2) — Telegram'dagi "Переслано от: X" ko'rsatkichi shu yerdan
  /// chiqadi. null = forward emas, oddiy xabar.
  fwdFromName String? @map("fwd_from_name") @db.VarChar(128)

  /// To'liq-tarix (2026-07-20). replyToTgMessageId — javob berilgan xabar
  /// (Faza-2 reply/quote uchun oldindan); editedAt — Telegram'da tahrirlangan
  /// vaqti; readByPeerAt — mijoz o'qigan vaqti (Faza-3 read-receipt uchun
  /// oldindan, nullable); outboxRefId — yetkazilgan HrTelegramOutbox qatoriga
  /// bog' (chiquvchi dedup).
  replyToTgMessageId BigInt?   @map("reply_to_tg_message_id")
  editedAt           DateTime? @map("edited_at") @db.Timestamptz()
  readByPeerAt       DateTime? @map("read_by_peer_at") @db.Timestamptz()
  outboxRefId        String?   @map("outbox_ref_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chat    TelegramChat @relation(fields: [chatRefId], references: [id], onDelete: Cascade)

  /// Bir chatda bitta tgMessageId — backfill/catch-up idempotent upsert kaliti
  /// (dublikat xabar yozilmaydi). tgMessageId NULL qatorlar (eski Bot API)
  /// Postgres multi-NULL bilan to'qnashmaydi.
  @@unique([chatRefId, tgMessageId])
  @@index([accountId, chatRefId, createdAt(sort: Desc)])
  @@map("telegram_chat_messages")
}

/// Talab-bo'yicha to'liq-tarix backfill navbati (2026-07-20). Panel birinchi
/// ochilganda upsert qilinadi (queued); TelegramBackfillWorker bitta-bitta
/// drenaj qiladi (dialog tarixini sahifalab TelegramChatMessage'ga yozadi).
model TelegramBackfillJob {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  counterpartyId   String    @map("counterparty_id") @db.Uuid
  phone            String    @db.VarChar(32)
  status           String    @default("queued") @db.VarChar(10) // queued|running|done|error
  requestedAt      DateTime  @default(now()) @map("requested_at") @db.Timestamptz()
  startedAt        DateTime? @map("started_at") @db.Timestamptz()
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz()
  messagesImported Int       @default(0) @map("messages_imported")
  /// Keyingi (eskiroq) sahifa uchun offsetId — 0/NULL = eng yangidan.
  cursorOffsetId   BigInt?   @map("cursor_offset_id")
  failReason       String?   @map("fail_reason") @db.VarChar(500)

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation("TgBackfillCp", fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@unique([accountId, counterpartyId])
  @@index([status, requestedAt])
  @@map("telegram_backfill_job")
}

// ===== Sherset KEEP: MessageTemplate (sms/telegram shablon) — B3 =====
model MessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  channel   String   @default("sms") @db.VarChar(16) // 'sms' | 'telegram'
  key       String?  @db.VarChar(50)
  name      String   @db.VarChar(120)
  body      String   @db.Text
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, channel])
  @@map("sms_templates")
}

// =========================================================================
// «Yig'ish ro'yxati» (pick-list / yacheykali chek) — TASHQI (haqiqiy) MoySklad
// hisobidan «Заказ покупателя» + «Возврат покупателя» snapshot'i (climart port
// 2026-07-28). Kassir MoySklad'da ishlaydi; ombor BIZNING saytni ochib har
// tovarni uy-yacheykasi (__yacheyka) bilan yig'ish-varaqda chop etadi.
// Pozitsiyalar snapshot [{msAssortmentId,name,qty,code,barcode,...}]; uy-yacheyka
// SAQLANMAYDI — print (READ) paytida bizning mahsulotdan hal qilinadi (qayta-
// bog'lash keyingi chopda darhol ko'rinadi). Standalone (Account-relation yo'q).
// =========================================================================
model MsPickList {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  msOrderId   String    @map("ms_order_id") @db.Uuid
  docType     String    @default("customerorder") @map("doc_type") @db.VarChar(30)
  name        String    @db.VarChar(64)
  moment      DateTime  @db.Timestamptz()
  /// MoySklad `updated` — sync-kursor; max(msUpdatedAt) keyingi poll'ni boshqaradi.
  msUpdatedAt DateTime  @map("ms_updated_at") @db.Timestamptz()
  agentName   String?   @map("agent_name") @db.VarChar(255)
  agentPhone  String?   @map("agent_phone") @db.VarChar(64)
  storeName   String?   @map("store_name") @db.VarChar(255)
  ownerName   String?   @map("owner_name") @db.VarChar(255)
  description String?   @db.Text
  sumMinor    BigInt    @default(0) @map("sum_minor")
  /// MoySklad «Проведено» — faqat provedeno buyurtmalar pick-list sifatida ko'rinadi.
  applicable  Boolean   @default(true)
  /// MoySklad payedSum (tiyin) — ro'yxat Оплачен/Частично/Не оплачен ko'rsatadi.
  payedMinor  BigInt    @default(0) @map("payed_minor")
  positions   Json      @default("[]")
  printedAt   DateTime? @map("printed_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([accountId, msOrderId])
  @@index([accountId, moment(sort: Desc)])
  @@map("ms_pick_lists")
}
