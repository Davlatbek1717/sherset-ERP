// === HR GPS-davomat (avtomatik keldi/ketdi) ===
// TZ: docs/superpowers/specs/2026-07-23-hr-gps-attendance-design.md

/// A work-location geofence (filial). Employees are assigned to one; their
/// browser PWA pings GPS and the backend auto-marks keldi/ketdi within radius.
model HrWorkLocation {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  name         String   @db.VarChar(150)
  lat          Float
  lng          Float
  radiusMeters Int      @default(150) @map("radius_meters")
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account         Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employees       Employee[]         @relation("EmployeeWorkLocation")
  branchEmployees HrEmployeeBranch[] @relation("BranchEmployees")

  @@index([accountId, archived])
  @@map("hr_work_locations")
}

/// Per-employee weekly work schedule (one row per weekday).
/// weekday: 0=Sunday … 6=Saturday (JS getDay convention — LOCKED).
model EmployeeWorkSchedule {
  id         String  @id @default(uuid()) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  employeeId String  @map("employee_id") @db.Uuid
  weekday    Int
  startTime  String  @map("start_time") @db.VarChar(5) // "09:00"
  endTime    String  @map("end_time") @db.VarChar(5) // "18:00"
  isDayOff   Boolean @default(false) @map("is_day_off")

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee Employee @relation("EmployeeSchedule", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, weekday])
  @@index([accountId, employeeId])
  @@map("employee_work_schedules")
}

/// GPS ping stream — audit + state-machine source. Retained 7 days, then a
/// cron deletes them; only HrAttendance (keldi/ketdi) is permanent.
model HrLocationPing {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  lat        Float
  lng        Float
  accuracy   Int
  inside     Boolean
  /// Instantaneous GPS speed (m/s) — nullable (older/geofence pings omit it).
  /// Used by FIELD-mode stop-detection (TZ 2026-07-28 §7) alongside displacement.
  speed      Float?
  /// GPS heading 0–360° — nullable. Drives the live-map marker direction.
  heading    Float?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, employeeId, createdAt(sort: Desc)])
  @@map("hr_location_pings")
}

// === HR haydovchi jonli-tracking (TZ 2026-07-28-hr-driver-tracking-design.md) ===

/// Bitta yetkazma: haydovchi ↔ manzil. ETA shu trip destatsiyasiga hisoblanadi.
/// `accountId` — plain scalar (Account back-relation'siz; ko'p-ijara filtri +index
/// orqali), asosiy referensial butunlik `driver` FK'da. Cascade migration SQL'da.
model DriverTrip {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  driverId       String    @map("driver_id") @db.Uuid
  // Manba hujjat (ixtiyoriy — qo'lda ham yaratiladi)
  orderType      String?   @map("order_type") @db.VarChar(20) // 'demand' | 'retail_sale' | 'manual'
  orderId        String?   @map("order_id") @db.Uuid
  // Manzil (gibrid: avto-geocode + qo'lda tuzatilishi mumkin)
  destLat        Float     @map("dest_lat")
  destLng        Float     @map("dest_lng")
  destAddress    String?   @map("dest_address")
  geocodeSource  String    @default("manual") @map("geocode_source") @db.VarChar(10) // 'auto' | 'manual'
  // Holat-mashina: assigned → enroute → arrived → completed | cancelled
  status         String    @default("assigned") @map("status") @db.VarChar(12)
  assignedAt     DateTime  @default(now()) @map("assigned_at") @db.Timestamptz()
  startedAt      DateTime? @map("started_at") @db.Timestamptz()
  arrivedAt      DateTime? @map("arrived_at") @db.Timestamptz()
  completedAt    DateTime? @map("completed_at") @db.Timestamptz()
  // Oxirgi hisoblangan ETA (SSE push manbai)
  distanceMeters Int?      @map("distance_meters")
  etaSeconds     Int?      @map("eta_seconds")
  etaComputedAt  DateTime? @map("eta_computed_at") @db.Timestamptz()

  driver Employee @relation("DriverTrips", fields: [driverId], references: [id], onDelete: Cascade)

  @@index([accountId, driverId, status])
  @@index([accountId, status])
  @@map("driver_trips")
}

/// Haydovchi ish-smenasi — grafiksiz ish o'lchovi (jadval-kechikish EMAS).
/// Yig'ma (km/active/stop/deliveries) ping-oqimidan hisoblanadi.
model DriverShift {
  id              String    @id @default(uuid()) @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  driverId        String    @map("driver_id") @db.Uuid
  startedAt       DateTime  @map("started_at") @db.Timestamptz()
  endedAt         DateTime? @map("ended_at") @db.Timestamptz()
  distanceMeters  Int       @default(0) @map("distance_meters")
  activeSeconds   Int       @default(0) @map("active_seconds")
  stopSeconds     Int       @default(0) @map("stop_seconds")
  deliveriesCount Int       @default(0) @map("deliveries_count")
  autoClosed      Boolean   @default(false) @map("auto_closed")

  driver Employee @relation("DriverShifts", fields: [driverId], references: [id], onDelete: Cascade)

  @@index([accountId, driverId, startedAt(sort: Desc)])
  // PARTIAL UNIQUE (xom-SQL migratsiyada, Prisma modellay olmaydi — Employee username
  // partial index kabi): `driver_shifts_one_open_per_driver ON (account_id, driver_id)
  // WHERE ended_at IS NULL` — har haydovchida bir vaqtda bitta ochiq smena.
  // `migrate dev` bu indexni diff'да ko'rsatadi (DROP taklif qiladi) — QO'LLAMA.
  @@map("driver_shifts")
}

model HrNotificationTemplate {
