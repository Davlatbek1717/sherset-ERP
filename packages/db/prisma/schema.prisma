model HrTelegramOutbox {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  counterpartyId    String?   @map("counterparty_id") @db.Uuid
  employeeId        String?   @map("employee_id") @db.Uuid
  // toPhone is nullable: a self-send (toSelf=true → 'me'/Saqlangan xabarlar)
  // has no recipient phone; the mtproto adapter uses viaSlot instead.
  toPhone           String?   @map("to_phone") @db.VarChar(20)
  toSelf            Boolean   @default(false) @map("to_self")
  viaSlot           Int?      @map("via_slot")
  messageText       String    @map("message_text")
  // Optional file to send as a Telegram document (акт-сверка .xlsx). When set,
  // the mtproto worker uses sendFile(caption=messageText) instead of a text send.
  attachmentPath    String?   @map("attachment_path")
  status            String    @default("pending") @db.VarChar(20)
  retryCount        Int       @default(0) @map("retry_count")
  nextRetryAt       DateTime? @map("next_retry_at") @db.Timestamptz()
  sentAt            DateTime? @map("sent_at") @db.Timestamptz()
  failReason        String?   @map("fail_reason")
  sourceEventType   String?   @map("source_event_type") @db.VarChar(50)
  sourceDocId       String?   @map("source_doc_id") @db.Uuid
  telegramMessageId String?   @map("telegram_message_id") @db.VarChar(50)
  sentBySlot        Int?      @map("sent_by_slot")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty Counterparty? @relation("HrOutboxCp", fields: [counterpartyId], references: [id])
  employee     Employee?     @relation("HrOutboxEmployee", fields: [employeeId], references: [id])

  @@index([accountId, status, nextRetryAt])
  @@index([accountId, counterpartyId, createdAt(sort: Desc)])
  @@map("hr_telegram_outbox")
}

/// Kontragent akt-sverka (reconciliation statement) — a generated .xlsx snapshot
/// of a counterparty's full transaction history + final balance. Stored on disk
/// (filePath) and served via an unguessable capability token (fileToken). Scalar
/// FKs only (no relation navigation) to keep the Counterparty/Account models untouched.
model CounterpartyStatement {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  // Nullable: a product-scoped report (buyum→kontragentlar) has no single agent.
  counterpartyId    String?   @map("counterparty_id") @db.Uuid
  // Set for product reports (Report B) and product-filtered agent akts (Report A).
  productId         String?   @map("product_id") @db.Uuid
  periodFrom        DateTime? @map("period_from") @db.Timestamptz()
  periodTo          DateTime? @map("period_to") @db.Timestamptz()
  fileToken         String    @unique @map("file_token") @db.VarChar(64)
  filePath          String    @map("file_path")
  fileName          String    @map("file_name") @db.VarChar(255)
  finalBalanceMinor BigInt    @default(0) @map("final_balance_minor")
  currency          String    @default("UZS") @db.VarChar(3)
  createdById       String?   @map("created_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([accountId, counterpartyId, createdAt(sort: Desc)])
  @@map("counterparty_statement")
}

model HrBonusFineLog {
