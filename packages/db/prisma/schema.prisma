/// Atomic per-account document-number counter. One row per (account, key),
/// where `key` is the doc-type + year prefix (e.g. "ЗП-2026-"). Numbers are
/// handed out via an atomic `value: { increment: 1 }` (Postgres row lock) so
/// concurrent document creates always get distinct sequential numbers. This
/// replaces the old read-max-then-insert auto-numbering (findFirst orderBy
/// name desc → lastN + 1), which raced under load: two creates read the same
/// max, both wrote the same name, and the loser hit the (account_id, name)
/// unique constraint → a spurious 409 that silently dropped the document.
/// The counter is lazily seeded from the current max on first use.
model DocumentSequence {
  accountId String   @map("account_id") @db.Uuid
  key       String   @db.VarChar(64)
  value     Int      @default(0)
  // @default(now()) matches the DB-level DEFAULT CURRENT_TIMESTAMP the creating
  // migration set; @updatedAt keeps it fresh on writes. Both present so the column
  // is never NULL even on a raw-SQL insert (defence) AND `prisma migrate diff`
  // stays clean (without the default, Prisma perpetually wants to DROP it).
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, key])
  @@map("document_sequences")
}

// User / Employee of a tenant.
model Employee {
  // Sherset KEEP (debts) back-relations — B2
  ownedDebts           Debt[]        @relation("DebtOwner")
  issuedDebts          Debt[]        @relation("DebtIssuer")
  debtPaymentsTook     DebtPayment[] @relation("DebtPaymentReceiver")
  debtPaymentsReversed DebtPayment[] @relation("DebtPaymentReverser")
  debtNotesWritten     DebtNote[]    @relation("DebtNoteAuthor")
  debtNotesCanceled    DebtNote[]    @relation("DebtNoteCanceler")
  id                   String        @id @default(uuid()) @db.Uuid
  accountId            String        @map("account_id") @db.Uuid
  ownerId              String?       @map("owner_id") @db.Uuid
  email                String        @db.VarChar(255)
  passwordHash         String        @default("") @map("password_hash") @db.VarChar(255)
  name                 String        @db.VarChar(255)
  firstName            String?       @map("first_name") @db.VarChar(100)
  lastName             String?       @map("last_name") @db.VarChar(100)
  middleName           String?       @map("middle_name") @db.VarChar(100)
  // Display-time helpers moysklad pre-computes:
  //   fullName  — "lastName firstName middleName"
  //   shortFio  — "lastName F.M." (Russian convention)
  // We store both denormalised so reports don't recompute.
  fullName             String?       @map("full_name") @db.VarChar(310)
  shortFio             String?       @map("short_fio") @db.VarChar(120)
  position             String?       @db.VarChar(255)
  phone                String?       @db.VarChar(20)
  // Personal STIR (only for natural persons / sole proprietors).
  inn                  String?       @db.VarChar(20)
  // Salary base + currency (UZS minor units). UI hides this from non-HR roles.
  salaryMinor          BigInt?       @map("salary_minor")
  salaryCurrency       String        @default("UZS") @map("salary_currency") @db.VarChar(3)
  // Profile photo bytes. Inline (small) — separate uploads use Attachment.
  imageContent         Bytes?        @map("image_content")
  imageMime            String?       @map("image_mime") @db.VarChar(100)
  description          String?
  externalCode         String?       @map("external_code") @db.VarChar(50)
  // Stable user identifier — moysklad's auth subject id (`uid` field).
  uid                  String?       @db.VarChar(64)
  shared               Boolean       @default(false)
  attributes           Json?         @default("{}")
  // Group/department (for OWN_GROUP permission scope)
  groupId              String?       @map("group_id") @db.Uuid
  // Login tracking
  lastLoginAt          DateTime?     @map("last_login_at") @db.Timestamptz()
  failedLoginAttempts  Int           @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?     @map("locked_until") @db.Timestamptz()
  archived             Boolean       @default(false)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  // Optimistic-lock token (moysklad parity). Guards the field-edit forms that
  // edit this shared row — HR /hr/employees (PUT), Analitika /analitika/staff
  // (PATCH) and the self-profile /auth/me. Auth bookkeeping writes
  // (lastLoginAt/failedLoginAttempts/lockedUntil/passwordHash) deliberately do
  // NOT touch version: they are not edit-form fields, so bumping them would
  // 409 every admin edit-form after any login. See _PHASE2-optimistic-lock.audit.md.
  version              Int           @default(1)

  // === HR module fields (P0 sprint) ===
  // All nullable/defaulted for backward compatibility. Populated when
  // an employee opts into the HR workflow (set-password + telegram link).
  username                   String?   @db.VarChar(50)
  isChecker                  Boolean   @default(false) @map("is_checker")
  telegramPhone              String?   @map("telegram_phone") @db.VarChar(20)
  // Bot API chat_id — qabul-tasdiqlash inline-tugmalari uchun (Faza D1, 2026-07-30).
  // `/start bind_<token>` deep-link orqali to'ldiriladi; token bir-martalik + muddatli.
  telegramChatId             String?   @map("telegram_chat_id") @db.VarChar(64)
  telegramBindToken          String?   @unique @map("telegram_bind_token") @db.VarChar(64)
  telegramBindTokenExpiresAt DateTime? @map("telegram_bind_token_expires_at") @db.Timestamptz()
  moyskladAgentId            String?   @map("moysklad_agent_id") @db.Uuid
  department                 String?   @db.VarChar(100)
  hrRoles                    String[]  @default([]) @map("hr_roles")
  /// Per-employee salary override. If null, fallback to HrSalaryConfig
  /// (per-account singleton). Shape: { fixWeight, kpiWeight, bonusWeight,
  /// monthlySalesTarget, monthlyKpiBudget, commissionPercent, kpiTiers[] }.
  salaryConfig               Json?     @map("salary_config")

  // === HR GPS-davomat (attendance geofence) ===
  // All nullable/defaulted — prod-safe, no backfill. Populated when an
  // employee is assigned to a work-location and opts into GPS tracking.
  workLocationId  String?         @map("work_location_id") @db.Uuid
  workLocation    HrWorkLocation? @relation("EmployeeWorkLocation", fields: [workLocationId], references: [id], onDelete: SetNull)
  attendanceOptIn Boolean         @default(false) @map("attendance_opt_in")
  // === HR haydovchi jonli-tracking (TZ 2026-07-28) ===
  // 'geofence' = ofis xodimi (jadval-kechikish davomat, mavjud xulq).
  // 'field'    = haydovchi (jonli iz + smena/yetkazma; jadval-kechikish O'CHIQ).
  // Default 'geofence' → mavjud xodimlar xulqi o'zgarmaydi (prod-safe, backfillsiz).
  trackingMode    String          @default("geofence") @map("tracking_mode") @db.VarChar(10)

  // === HR TimePay davomat: department / position / schedule (all nullable — prod-safe, no backfill) ===
  // New FK source-of-truth going forward; legacy `department`/`position` string
  // columns above are kept for back-compat (display fallback). See spec
  // docs/superpowers/specs/2026-07-24-hr-timepay-attendance-core-design.md §4.
  departmentId String?            @map("department_id") @db.Uuid
  department2  HrDepartment?      @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  positionId   String?            @map("position_id") @db.Uuid
  position2    HrPosition?        @relation("EmployeePosition", fields: [positionId], references: [id], onDelete: SetNull)
  scheduleId   String?            @map("schedule_id") @db.Uuid
  schedule     HrSchedule?        @relation("EmployeeSchedule2", fields: [scheduleId], references: [id], onDelete: SetNull)
  // Multi-branch: full assigned set (Employee.workLocationId above stays as primary/default branch).
  branches     HrEmployeeBranch[] @relation("EmployeeBranches")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

