// =========================================================================
// Sprint 12.5 — CBRU exchange rates (UZ Tier-1)
// =========================================================================

/// Daily exchange rate snapshot vs UZS, fetched from cbu.uz public API.
/// Stored at the global (account-less) level since the central-bank rate
/// is the same for everyone — saves N×rows per tenant. Per-tenant manual
/// overrides (e.g. internal rate margin) live elsewhere (V2).
///
/// Rate is stored as Decimal(20,6) since CBRU publishes 4–6 decimal digits.
/// Convention: rate × amount(currency) / nominal = amount(UZS).
model ExchangeRate {
  /// Date this rate is effective FOR (the rate published on D applies for D).
  /// CBRU publishes weekday-only; consumers carry forward (last-known) on weekends.
  date      DateTime @db.Date
  currency  String   @db.VarChar(3)
  rate      Decimal  @db.Decimal(20, 6)
  /// Source identifier — 'CBRU' for the central-bank feed. Future sources
  /// (CB user override, parallel-market) discriminate via this column.
  source    String   @default("CBRU") @db.VarChar(20)
  /// CBRU's nominal divisor — currencies like KRW quote per-1000.
  nominal   Int      @default(1)
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz()

  @@id([date, currency, source])
  @@index([currency, date(sort: Desc)])
  @@map("exchange_rates")
}

// =========================================================================
// Sprint 12.6 — MXIK (UZ tax classifier)
// =========================================================================

/// MXIK = Mahsulot va xizmatlarning xalq ro'yxati — Uzbekistan's mandatory
/// tax classifier code. Every VAT-bearing line item on a tax invoice must
/// reference one MXIK. The official catalog is published by Soliq (tax
/// authority) at tasnif.soliq.uz; ~250k entries spanning all goods and
/// services. We cache it locally so invoice forms can autocomplete without
/// hitting an external API on every keystroke.
///
/// Stored at the global (account-less) level — the catalog is the same for
/// every tenant. Authoritative source is Soliq; the `source` column lets a
/// future tenant override (custom internal codes) layer above without
/// stepping on the imported rows.
///
/// V1 scope: manual entry + CSV bulk-import. The auto-sync against
/// tasnif.soliq.uz is a follow-up because their public endpoint requires
/// merchant authentication — V1.5 will wire it once credentials are
/// provisioned.
model MxikCode {
  /// 17-digit Soliq classifier code (always exactly 17 chars, decimal).
  code String @id @db.VarChar(17)

  /// Localized names — UZ Latin is canonical for the UI; Russian is the
  /// most common cyrillic locale in older invoices. English is best-effort.
  nameUz String  @map("name_uz") @db.VarChar(500)
  nameRu String? @map("name_ru") @db.VarChar(500)
  nameEn String? @map("name_en") @db.VarChar(500)

  /// Unit-of-measure code from the Soliq UoM catalog (e.g. '796' = piece).
  /// Free-form here because the UoM catalog itself is a separate table V1.5.
  unitCode String? @map("unit_code") @db.VarChar(20)

  /// Group / class hierarchy. The 17-digit code is itself hierarchical
  /// (first 4 = section, next 4 = group, etc.); we denormalize the parent
  /// chain into these strings so search-by-section is a simple LIKE.
  groupCode String? @map("group_code") @db.VarChar(17)
  classCode String? @map("class_code") @db.VarChar(17)

  /// Where this row came from — 'soliq' for the imported catalog, 'manual'
  /// for tenant-specific custom additions, 'override' for tenant overrides
  /// of an imported row. V1 only writes 'manual' (CSV import via the UI).
  source String @default("manual") @db.VarChar(20)

  /// Soft-archive — Soliq retires codes occasionally; we keep the row so
  /// historical invoices still resolve, just hide it from autocomplete.
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([archived, nameUz])
  @@index([groupCode])
  @@map("mxik_codes")
}

/// AttributeMetadata — configurable custom field definitions per entity type.
///
/// Mirrors moysklad's "Дополнительные поля" — admins create new fields per
/// entity (Counterparty, Product, CustomerOrder, Demand, ...) and each
/// document/entity then stores its values in its own `attributes Json`
/// column. The metadata row is the source of truth for type, required-ness,
/// enum options, and reference target.
///
/// Field codes are unique per (account, entity). The code is what the
/// `attributes` JSON keys against; renaming `name` is safe, renaming `code`
/// requires a migration of existing values.
model AttributeMetadata {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Target entity type — must match one of the documented entity names:
  /// "Counterparty" | "Product" | "Variant" | "Bundle" | "Service" |
  /// "ProductFolder" | "CustomerOrder" | "Demand" | "InvoiceOut" |
  /// "SalesReturn" | "PurchaseOrder" | "Supply" | "InvoiceIn" |
  /// "PurchaseReturn" | "Move" | "Loss" | "Enter" | "Inventory" |
  /// "PaymentIn" | "PaymentOut" | "CashIn" | "CashOut" | "Project" |
  /// "Contract" | "Employee" | "Organization" | "Store" | "ProcessingPlan" |
  /// "RetailSale" | "InternalOrder" | "Prepayment" | "PriceList".
  entity String @db.VarChar(50)

  /// Machine name — used as the JSON key in entity.attributes.
  /// Lowercase, alphanumeric + underscore. Cannot be changed once created.
  code String @db.VarChar(50)

  /// Human label shown in UI (Uzbek/Russian).
  name String @db.VarChar(255)

  /// Field type:
  ///   "string" | "text" | "long" | "double" | "boolean" | "date" |
  ///   "file" | "link" | "enum" | "reference"
  type String @db.VarChar(20)

  /// Whether the field is required. Validated server-side on create/update.
  required Boolean @default(false)

  /// Default value when not provided. JSON-encoded so it works for any type.
  defaultValue Json? @map("default_value")

  /// Optional help text shown under the input.
  description String?

  /// For type="enum" — array of { value, label } options.
  /// For type="reference" — set referenceEntity instead.
  enumOptions Json? @map("enum_options")

  /// For type="reference" — entity name being referenced ("Counterparty",
  /// "Product", "CustomEntity", ...). Validated against entity allowlist.
  referenceEntity String? @map("reference_entity") @db.VarChar(50)

  /// For type="reference" with referenceEntity="CustomEntity" — the
  /// specific CustomEntity dictionary id. The value JSON stores the
  /// CustomEntityValue id.
  customEntityId String? @map("custom_entity_id") @db.Uuid

  /// Sort position within the entity's attribute list.
  position Int @default(0)

  /// Hide from create/edit forms but keep historical values addressable.
  archived Boolean @default(false)

  /// Show in subaccounts (multi-tenant features moysklad has — currently
  /// always per-account here, but kept for forward compatibility).
  shared Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([accountId, entity, code])
  @@index([accountId, entity, archived, position])
  @@map("attribute_metadata")
}

// =========================================================================
// Sprint 20 — Service Desk (Заявки)
// =========================================================================

/// Service request / customer ticket. moysklad-equivalent: "Заявка".
/// Customer-facing support flow with SLA + assignment + audit trail.
///
/// FSM:
///   new → in_progress (manual; assignee picks up)
///   in_progress → waiting_customer (need more info)
///   waiting_customer → in_progress
///   in_progress | waiting_customer → resolved
///   resolved → closed (after grace window or customer confirmation)
///   any → cancelled (drop request without resolution)
model ServiceRequest {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  /// Auto-numbered: ZP-YYYY-NNNNN ("Заявка").
  name         String  @db.VarChar(100)
  externalCode String? @map("external_code") @db.VarChar(50)

  /// Subject line shown in lists / notifications.
  subject     String  @db.VarChar(500)
  description String?

  /// Counterparty who raised the ticket. Nullable for internal tickets.
  counterpartyId  String? @map("counterparty_id") @db.Uuid
  contactPersonId String? @map("contact_person_id") @db.Uuid

  /// Current owner / responder.
  assigneeId String? @map("assignee_id") @db.Uuid

  /// 'phone' | 'email' | 'chat' | 'in_person' | 'web_form' | 'other'
  channel  String @default("other") @db.VarChar(20)
  /// 'low' | 'normal' | 'high' | 'critical'
  priority String @default("normal") @db.VarChar(20)
  /// 'new' | 'in_progress' | 'waiting_customer' | 'resolved' | 'closed' | 'cancelled'
  status   String @default("new") @db.VarChar(30)

  /// SLA target — when this ticket should be resolved by.
  dueDate    DateTime? @map("due_date") @db.Timestamptz()
  /// Set when status moves to 'resolved'.
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz()
  /// Set when status moves to 'closed'.
  closedAt   DateTime? @map("closed_at") @db.Timestamptz()

  attributes Json?    @default("{}")
  tags       String[] @default([])

  shared   Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner         Employee?      @relation("ServiceRequestOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assignee      Employee?      @relation("ServiceRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  group         Group?         @relation("ServiceRequestGroup", fields: [groupId], references: [id], onDelete: SetNull)
  counterparty  Counterparty?  @relation("ServiceRequestCp", fields: [counterpartyId], references: [id], onDelete: SetNull)
  contactPerson ContactPerson? @relation("ServiceRequestContact", fields: [contactPersonId], references: [id], onDelete: SetNull)

  @@unique([accountId, name])
  /// Hot path: active queue ordered by SLA.
  @@index([accountId, status, dueDate])
  /// Per-assignee list view.
  @@index([accountId, assigneeId, status])
  /// Per-counterparty history (customer-portal lookup).
  @@index([accountId, counterpartyId, createdAt(sort: Desc)])
  @@map("service_requests")
}

// =========================================================================
// Sprint 21 — Print template editor
// =========================================================================

/// Custom print template — moysklad's "Шаблоны печатных форм".
///
/// Per-account override of the default Handlebars-style template body
/// for a given document type. When a doc is printed, PrintService looks
/// for a template here matching (entity, format) — falls back to the
/// hardcoded default when none exists. Operators can clone, edit, and
/// disable per-account.
model PrintTemplate {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid

  /// Document discriminator: 'invoiceout' | 'demand' | 'customerorder' | ...
  /// Lowercase moysklad slugs (matches Webhook entityType convention).
  entity String @db.VarChar(40)
  /// Output format: 'pdf' | 'docx' | 'html' | 'txt'.
  format String @default("pdf") @db.VarChar(10)

  name        String  @db.VarChar(255)
  description String?

  /// Handlebars-flavoured template source. Variables resolved at render
  /// time from the document context: {{order.number}}, {{customer.name}},
  /// {{#each positions}}, etc. See docs/print-template-vars.md.
  bodyHtml String @map("body_html")

  /// Template content (binary) when uploaded as DOCX. Mutually exclusive
  /// with bodyHtml — operator picks one editor mode at create time.
  bodyDocx Bytes? @map("body_docx")

  /// Page size + margins for PDF rendering.
  pageSize     String @default("A4") @map("page_size") @db.VarChar(10)
  marginTop    Int    @default(20) @map("margin_top")
  marginRight  Int    @default(15) @map("margin_right")
  marginBottom Int    @default(20) @map("margin_bottom")
  marginLeft   Int    @default(15) @map("margin_left")

  /// Default template for its (entity, format) pair — only one per pair.
  /// Set true to override the system default; when this row is disabled
  /// or deleted, the system default re-takes over.
  isDefault Boolean @default(false) @map("is_default")
  enabled   Boolean @default(true)
  archived  Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Lookup at print time: pick the enabled, default template for (entity,format).
  @@index([accountId, entity, format, enabled, isDefault])
  @@index([accountId, archived])
  @@map("print_templates")
}

// =========================================================================
// Sprint 22 — Help drawer / knowledge base
// =========================================================================

/// Help article — context-aware doc shown in the right-side help drawer.
/// Per-account so operators can localise / supplement the system articles.
/// Articles are rendered as Markdown; the drawer surfaces by route key.
model HelpArticle {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Stable slug — referenced from the UI via Help.openArticle('demand-post').
  slug String @db.VarChar(120)

  /// Optional route-key match — when the user is on a path matching this
  /// pattern (substring match), the drawer shows this article first.
  /// Examples: '/demands', '/customer-orders/[id]', '/settings/email'.
  routeKey String? @map("route_key") @db.VarChar(120)

  /// 'uz' | 'ru' — same article slug, different locales.
  locale String @default("uz") @db.VarChar(8)

  title    String   @db.VarChar(255)
  /// Markdown body — rendered with light prose styling in the drawer.
  bodyMd   String   @map("body_md")
  /// Sort key inside its category section.
  position Int      @default(0)
  category String?  @db.VarChar(80)
  tags     String[] @default([])

  enabled  Boolean @default(true)
  archived Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, slug, locale])
  @@index([accountId, routeKey, enabled, locale])
  @@index([accountId, category, position])
  @@map("help_articles")
}

// =========================================================================
// Sprint 23 — Onboarding wizard
// =========================================================================

/// Per-account onboarding progress tracker. One row per account, written
/// once on first login and updated as the user completes each wizard step.
/// The web app reads this on /dashboard mount and resumes the wizard if
/// not all steps are done.
///
/// Steps (string keys for forward compat — schema doesn't enforce):
///   organization · currency · store · first_product · first_counterparty ·
///   first_sale · email_setup · skipped
model OnboardingProgress {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  /// Which step the user is currently on (or 'done' / 'skipped' terminal).
  currentStep    String   @default("organization") @map("current_step") @db.VarChar(40)
  /// Steps completed so far (allows out-of-order completion).
  completedSteps String[] @default([]) @map("completed_steps")

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()
  skippedAt   DateTime? @map("skipped_at") @db.Timestamptz()

  /// User who started the wizard (creator/admin of the tenant).
  startedById String? @map("started_by_id") @db.Uuid

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

// =========================================================================
// Sprint 26b — Eskiz SMS integration
// =========================================================================

/// Per-account Eskiz SMS provider config. Eskiz is a UZ SMS aggregator
/// (eskiz.uz) that issues a JWT-bearer-style token after email/password
/// auth; our service stores the token + auto-refreshes when 401 hits.
model SmsConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  /// 'eskiz' | 'playmobile' | 'custom' — extensible for future UZ providers.
  provider String @default("eskiz") @db.VarChar(20)

  /// Eskiz login email.
  email          String @db.VarChar(255)
  /// Eskiz password (AES-encrypted at rest, same crypto helpers as EmailConfig).
  passwordCipher String @map("password_cipher") @db.VarChar(500)

  /// Optional sender alphanumeric ID (3–11 chars). Eskiz default is the
  /// caller's verified sender; null = use account default.
  senderId String? @map("sender_id") @db.VarChar(20)

  /// Cached bearer token from /api/auth/login. Refreshed lazily on 401.
  token         String?   @db.VarChar(2000)
  tokenIssuedAt DateTime? @map("token_issued_at") @db.Timestamptz()

  /// Last health-check stamp + verdict (for the settings page badge).
  lastTestedAt DateTime? @map("last_tested_at") @db.Timestamptz()
  lastTestOk   Boolean?  @map("last_test_ok")
  lastTestMsg  String?   @map("last_test_msg") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("sms_configs")
}

/// SMS delivery log + retry queue (mirrors EmailLog pattern).
///
///   pending → sent | dead
///   Sequential cron worker drains pending (every 30s, BATCH_LIMIT=20).
///   Backoff: 0 / 1m / 5m / 15m / 1h.
model SmsLog {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  senderId  String? @map("sender_id") @db.Uuid

  entity   String? @db.VarChar(50)
  entityId String? @map("entity_id") @db.Uuid

  /// Destination phone in E.164 (+998901234567).
  toPhone String @map("to_phone") @db.VarChar(20)
  body    String @db.VarChar(1600)

  /// 'pending' | 'sent' | 'dead' | 'failed' (legacy from inline path).
  status      String @default("pending") @db.VarChar(20)
  attempt     Int    @default(1)
  maxAttempts Int    @default(4) @map("max_attempts")

  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz()
  attemptedAt DateTime? @map("attempted_at") @db.Timestamptz()
  sentAt      DateTime? @map("sent_at") @db.Timestamptz()

  /// Provider-side message id (Eskiz returns it on accept).
  providerMessageId String? @map("provider_message_id") @db.VarChar(100)
  errorMsg          String? @map("error_msg")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sender  Employee? @relation("SmsLogSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([status, nextRetryAt])
  @@index([accountId, createdAt(sort: Desc)])
  @@index([accountId, entity, entityId, createdAt(sort: Desc)])
  @@map("sms_logs")
}

// =========================================================================
// Sprint 27 — Soliq.uz EDO (E-Hujjat / Faktura)
// =========================================================================

/// Per-account EDO configuration. Soliq.uz is the UZ tax authority's
/// electronic-document portal; we authenticate via ECP (Electronic
/// Digital Signature) PFX file uploaded once per account.
model EdoConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  /// Org STIR (TIN) — must match ECP cert subject; Soliq rejects mismatches.
  stir        String @db.VarChar(20)
  /// Org name (Cyrillic short name as registered with Soliq).
  orgNameCyrl String @map("org_name_cyrl") @db.VarChar(255)

  /// 'didox' | 'edocs' | 'soliq_direct' — picks the gateway provider.
  /// Most tenants use Didox.uz which fronts Soliq's PKI.
  provider String @default("didox") @db.VarChar(20)

  /// Provider API URL (sandbox vs prod — tenant-controlled).
  apiBaseUrl     String  @map("api_base_url") @db.VarChar(255)
  /// API token issued by the provider (encrypted at rest).
  apiTokenCipher String? @map("api_token_cipher") @db.VarChar(2000)

  /// ECP PFX bytes (encrypted with EDO_PFX_KEY env). Used by SignerService
  /// to produce GOST signatures over EHF XML payloads.
  pfxCipher     Bytes?  @map("pfx_cipher")
  /// PFX unlock password (encrypted, same crypto helpers as EmailConfig).
  pfxPassCipher String? @map("pfx_pass_cipher") @db.VarChar(500)

  /// Test-mode marker — submissions go to provider sandbox endpoint.
  testMode Boolean @default(true) @map("test_mode")

  lastTestedAt DateTime? @map("last_tested_at") @db.Timestamptz()
  lastTestOk   Boolean?  @map("last_test_ok")
  lastTestMsg  String?   @map("last_test_msg") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("edo_configs")
}

/// EDO submission record — one row per outbound EHF (electronic invoice).
/// FSM: draft → signed → sent → delivered → confirmed | rejected.
/// Cancellation: cancelled (after delivered, by buyer/seller mutual ack).
model EdoSubmission {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Source document: usually FactureOut (счёт-фактура), sometimes Demand.
  sourceEntity   String @map("source_entity") @db.VarChar(50)
  sourceEntityId String @map("source_entity_id") @db.Uuid

  /// Provider-assigned EHF ID (returned on submit). Null until the
  /// provider accepts the signed payload.
  providerEhfId String? @map("provider_ehf_id") @db.VarChar(100)
  /// Provider-side numeric/QR identifier shown to the buyer.
  ehfNumber     String? @map("ehf_number") @db.VarChar(100)

  /// 'draft' | 'signed' | 'sent' | 'delivered' | 'confirmed' | 'rejected' | 'cancelled'
  status String @default("draft") @db.VarChar(20)

  /// XML body sent to the provider (signed if status >= 'signed').
  xmlBody      String? @map("xml_body")
  /// Detached signature (base64) returned by the signer.
  signatureB64 String? @map("signature_b64")

  signedAt    DateTime? @map("signed_at") @db.Timestamptz()
  sentAt      DateTime? @map("sent_at") @db.Timestamptz()
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz()
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz()

  /// Provider rejection reason or our local validation error.
  errorMsg    String? @map("error_msg")
  /// Buyer's STIR (target party); cached for indexing/reporting.
  buyerStir   String? @map("buyer_stir") @db.VarChar(20)
  /// Provider response payload (audit trail).
  providerLog Json?   @map("provider_log")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, sourceEntity, sourceEntityId])
  @@index([accountId, status, createdAt(sort: Desc)])
  @@index([providerEhfId])
  @@map("edo_submissions")
}

// =========================================================================
// Sprint 28 — ASL Belgisi (UZ markirovka)
// =========================================================================

/// Per-account ASL Belgisi config. ASL Belgisi (aslbelgisi.uz) is the
/// UZ government goods-marking system: every regulated SKU (alcohol,
/// tobacco, pharma, water, footwear, dairy) needs a unique GS1
/// DataMatrix code on its packaging. We track issued codes + their
/// lifecycle (allocated → applied → sold → retired/returned).
model MarkingConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  /// Org STIR — same as EDO, must match the merchant registered with
  /// ASL Belgisi.
  stir           String  @db.VarChar(20)
  /// Provider API URL — sandbox vs prod (tenant-controlled).
  apiBaseUrl     String  @map("api_base_url") @db.VarChar(255)
  /// API token (AES-encrypted).
  apiTokenCipher String? @map("api_token_cipher") @db.VarChar(2000)

  /// Test-mode marker — uses ASL Belgisi sandbox.
  testMode Boolean @default(true) @map("test_mode")

  lastTestedAt DateTime? @map("last_tested_at") @db.Timestamptz()
  lastTestOk   Boolean?  @map("last_test_ok")
  lastTestMsg  String?   @map("last_test_msg") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("marking_configs")
}

/// One marking code (DataMatrix string ~31-44 chars). Tracked through
/// its lifecycle: allocated → applied → sold | retired | returned.
model MarkingCodeRecord {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Which product this code is bound to (null until 'applied').
  productId String? @map("product_id") @db.Uuid
  /// Optional variant (modification) — for SKUs with size/color matrix.
  variantId String? @map("variant_id") @db.Uuid

  /// Raw GS1 DataMatrix string (encoded with FNC1 separators).
  /// Format: 01<GTIN-14>21<serial>91<crypto-key>92<crypto-tail>
  code   String @db.VarChar(200)
  /// Parsed GTIN (item identifier — 14 digits).
  gtin   String @db.VarChar(20)
  /// Parsed serial portion (unique within the GTIN).
  serial String @db.VarChar(40)

  /// 'allocated' | 'applied' | 'sold' | 'returned' | 'retired' | 'rejected'
  status String @default("allocated") @db.VarChar(20)

  /// Source document references (polymorphic): for 'sold' it's the
  /// RetailDemand id; for 'retired' it's the RetireOrder id; etc.
  sourceEntity   String? @map("source_entity") @db.VarChar(40)
  sourceEntityId String? @map("source_entity_id") @db.Uuid

  /// Provider response payload — kept for audit / Soliq inspection.
  providerLog Json?   @map("provider_log")
  errorMsg    String? @map("error_msg")

  allocatedAt DateTime? @map("allocated_at") @db.Timestamptz()
  appliedAt   DateTime? @map("applied_at") @db.Timestamptz()
  soldAt      DateTime? @map("sold_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, code])
  @@index([accountId, productId, status])
  @@index([accountId, status, createdAt(sort: Desc)])
  @@index([gtin, serial])
  @@map("marking_codes")
}

// =========================================================================
// Sprint 33 — Telegram bot integration
// =========================================================================

/// Per-account Telegram bot config. Bot tokens are issued by
/// @BotFather; one token per bot. The bot polls / receives webhooks
/// for incoming messages and sends outbound notifications via the
/// TelegramOutbox queue.
model TelegramConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  // Sherset KEEP (telegram business) — B3
  businessConnectionId String? @map("business_connection_id") @db.VarChar(64)
  businessUserId       BigInt? @map("business_user_id")
  businessUserName     String? @map("business_user_name") @db.VarChar(128)

  /// Bot token from BotFather (AES-encrypted).
  botTokenCipher String  @map("bot_token_cipher") @db.VarChar(500)
  /// Bot username — '@MyShopBot' (without @, as Telegram returns it).
  botUsername    String? @map("bot_username") @db.VarChar(50)

  /// Webhook URL Telegram pushes incoming messages to (we self-register
  /// it via setWebhook on save). Null = polling mode (legacy).
  webhookUrl    String? @map("webhook_url") @db.VarChar(500)
  /// HMAC secret for verifying inbound webhooks (Telegram includes
  /// X-Telegram-Bot-Api-Secret-Token header).
  webhookSecret String? @map("webhook_secret") @db.VarChar(255)

  /// Default chat to send broadcast notifications (admin group, channel).
  defaultChatId String? @map("default_chat_id") @db.VarChar(40)

  lastTestedAt DateTime? @map("last_tested_at") @db.Timestamptz()
  lastTestOk   Boolean?  @map("last_test_ok")
  lastTestMsg  String?   @map("last_test_msg") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("telegram_configs")
}

/// Outbound Telegram messages — same retry queue pattern as SMS/email.
model TelegramOutbox {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Telegram chat id — numeric (-100... for channels, positive for users).
  chatId    String @map("chat_id") @db.VarChar(40)
  /// Markdown / HTML / plain. Default 'HTML' so we can use bold/links.
  parseMode String @default("HTML") @map("parse_mode") @db.VarChar(20)
  text      String @db.VarChar(4096)

  /// 'pending' | 'sent' | 'dead' | 'failed'
  status      String @default("pending") @db.VarChar(20)
  attempt     Int    @default(1)
  maxAttempts Int    @default(4) @map("max_attempts")

  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz()
  attemptedAt DateTime? @map("attempted_at") @db.Timestamptz()
  sentAt      DateTime? @map("sent_at") @db.Timestamptz()

  /// Provider response message_id (for delete / reply tracking).
  providerMessageId String? @map("provider_message_id") @db.VarChar(40)
  errorMsg          String? @map("error_msg")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([accountId, createdAt(sort: Desc)])
  @@map("telegram_outbox")
}

// =========================================================================
// Sprint 29 — Payment gateways (Payme + Click + Uzcard/Humo)
// =========================================================================

/// Per-account configuration for a single payment gateway. One row per
/// (provider, accountId) — most accounts use one or two gateways. Each
/// provider has its own auth model captured in `credsJson` (encrypted).
model PaymentGatewayConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// 'payme' | 'click' | 'uzcard' | 'humo' | 'octo' | 'multicard'
  provider String @db.VarChar(20)
  /// Display label.
  name     String @db.VarChar(100)

  /// Provider's merchant id (Payme: merchant_id; Click: service_id; ...).
  merchantId  String @map("merchant_id") @db.VarChar(100)
  /// Encrypted credentials bag (provider-specific shape; AES-GCM).
  credsCipher String @map("creds_cipher") @db.VarChar(2000)

  /// Test-mode (sandbox endpoints).
  testMode Boolean @default(true) @map("test_mode")

  /// Webhook URL Payme/Click POST callbacks to. Stored for documentation
  /// + UI display; not strictly needed at runtime.
  callbackUrl String? @map("callback_url") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, provider])
  @@index([accountId, enabled])
  @@map("payment_gateway_configs")
}

/// One payment-gateway transaction. Lifecycle:
///   pending → authorized → captured | refunded | cancelled | failed
/// Each provider has slightly different terminology — we map them all
/// to this canonical FSM at the adapter layer.
model PaymentGatewayTx {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  provider     String  @db.VarChar(20)
  /// Provider's transaction id (Payme: id; Click: transaction_id).
  providerTxId String? @map("provider_tx_id") @db.VarChar(100)

  /// Source: usually a CustomerOrder or InvoiceOut id.
  sourceEntity   String @map("source_entity") @db.VarChar(40)
  sourceEntityId String @map("source_entity_id") @db.Uuid

  /// Amount in tiyin (UZS minor units — same convention as Money model).
  amountMinor BigInt @map("amount_minor")

  /// 'pending' | 'authorized' | 'captured' | 'refunded' | 'cancelled' | 'failed'
  status String @default("pending") @db.VarChar(20)

  authorizedAt DateTime? @map("authorized_at") @db.Timestamptz()
  capturedAt   DateTime? @map("captured_at") @db.Timestamptz()
  refundedAt   DateTime? @map("refunded_at") @db.Timestamptz()
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz()
  failedAt     DateTime? @map("failed_at") @db.Timestamptz()

  /// Provider response log — array of provider events for audit.
  providerLog Json?   @map("provider_log")
  errorMsg    String? @map("error_msg")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, provider, status])
  @@index([accountId, sourceEntity, sourceEntityId])
  @@index([providerTxId])
  @@map("payment_gateway_txs")
}

// =========================================================================
// Sprint 30 — Bank statement integration
// =========================================================================

/// Per-account bank API config — one row per bank connector. Most
/// accounts have 1-2 banks; large enterprises may have all 7+. UZ
/// banks differ in auth/format so each gets its own adapter that this
/// config drives.
model BankApiConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// 'nbu' | 'asaka' | 'anor' | 'kapital' | 'tbc' | 'trustbank' | 'hamkor'
  bankCode    String @map("bank_code") @db.VarChar(20)
  /// Org STIR (must match the bank's account holder).
  stir        String @db.VarChar(20)
  /// Bank account / IBAN equivalent (20-char UZ account number).
  bankAccount String @map("bank_account") @db.VarChar(50)
  /// Bank's MFI code (5-digit branch identifier).
  bankMfo     String @map("bank_mfo") @db.VarChar(10)

  /// API endpoint URL.
  apiBaseUrl  String @map("api_base_url") @db.VarChar(255)
  /// Encrypted credentials (each bank has its own auth — token, mTLS,
  /// HMAC; we just store the bag as encrypted JSON).
  credsCipher String @map("creds_cipher") @db.VarChar(4000)

  /// Last successful pull timestamp — drives next-pull delta queries.
  lastPullAt  DateTime? @map("last_pull_at") @db.Timestamptz()
  lastPullOk  Boolean?  @map("last_pull_ok")
  lastPullMsg String?   @map("last_pull_msg") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, bankCode, bankAccount])
  @@index([accountId, enabled])
  @@map("bank_api_configs")
}

// =========================================================================
// Sprint 31 — 1C two-way sync
// =========================================================================

/// Per-account 1C connector config. 1C 8.3 supports CommerceML 2.x
/// XML exchange via HTTP or file drop. V1 supports HTTP-only.
model OneCSyncConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  /// 1C HTTP endpoint URL (1C web-service / extension URL).
  endpointUrl    String @map("endpoint_url") @db.VarChar(500)
  /// Basic auth username for the 1C HTTP endpoint.
  username       String @db.VarChar(100)
  /// AES-encrypted password.
  passwordCipher String @map("password_cipher") @db.VarChar(500)

  /// Push direction: 'pull-only' (1C → us) | 'push-only' (us → 1C) |
  /// 'bidirectional'.
  direction String @default("bidirectional") @db.VarChar(20)

  /// Polling interval in minutes (cron uses this).
  pollIntervalMin Int @default(60) @map("poll_interval_min")

  /// Last sync stamp + verdict.
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz()
  lastSyncOk  Boolean?  @map("last_sync_ok")
  lastSyncMsg String?   @map("last_sync_msg") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("one_c_sync_configs")
}

/// Per-cycle 1C sync log entry. Captures direction, counts, and any
/// errors. Operators use this to diagnose missing data.
model OneCSyncLog {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// 'pull' | 'push' — which direction this cycle covered.
  direction String @db.VarChar(20)
  /// 'success' | 'partial' | 'failed'
  status    String @db.VarChar(20)

  /// Per-entity counts as a JSON map: {Counterparty: 12, Product: 350, ...}.
  counts Json @default("{}")

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  finishedAt DateTime? @map("finished_at") @db.Timestamptz()
  errorMsg   String?   @map("error_msg")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, startedAt(sort: Desc)])
  @@map("one_c_sync_logs")
}

// =========================================================================
// Sprint 32 — Marketplaces (Uzum / Yandex / Wildberries / Ozon)
// =========================================================================

/// Per-account marketplace seller config. One row per (marketplace, account).
model MarketplaceConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// 'uzum' | 'yandex' | 'wildberries' | 'ozon'
  marketplace String @db.VarChar(20)
  /// Seller's storefront name (display only).
  shopName    String @map("shop_name") @db.VarChar(255)
  /// Seller id assigned by the marketplace.
  sellerId    String @map("seller_id") @db.VarChar(100)

  /// API endpoint URL (each marketplace has prod/sandbox).
  apiBaseUrl  String @map("api_base_url") @db.VarChar(255)
  /// AES-encrypted API key / OAuth refresh token.
  credsCipher String @map("creds_cipher") @db.VarChar(2000)

  /// Last sync stamps — separate stamps for catalog push vs order pull.
  lastCatalogPushAt DateTime? @map("last_catalog_push_at") @db.Timestamptz()
  lastOrderPullAt   DateTime? @map("last_order_pull_at") @db.Timestamptz()

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, marketplace])
  @@map("marketplace_configs")
}

/// Inbound orders pulled from a marketplace. Each row mirrors the
/// marketplace's order id + status; downstream we materialise it into
/// our internal CustomerOrder (linked via `internalOrderId`).
model MarketplaceOrderRow {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  marketplace String @db.VarChar(20)
  /// Marketplace's order id (numeric or alphanumeric, varies).
  externalId  String @map("external_id") @db.VarChar(100)

  /// Provider-side status (raw — not mapped to our FSM at this layer).
  status String @db.VarChar(40)

  /// Total amount in tiyin (UZS), best-effort conversion if currency differs.
  totalMinor BigInt @map("total_minor")
  currency   String @default("UZS") @db.VarChar(3)

  /// Raw payload from the marketplace API — kept for audit + future
  /// re-mapping if our materialiser changes shape.
  rawJson Json @map("raw_json")

  /// Once we materialise this into a CustomerOrder, this points at it.
  /// Null while the row is unprocessed.
  internalOrderId String? @map("internal_order_id") @db.Uuid

  pulledAt DateTime @default(now()) @map("pulled_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, marketplace, externalId])
  @@index([accountId, marketplace, status])
  @@map("marketplace_orders")
}

enum TaskKind {
  CRM
  HR
}

// ============================================================================
// HR MODULE — P0 foundation (master spec § 3)
// ============================================================================
// 16 ta yangi `hr_*` table. Mavjud Employee/Task'larga additive kengaytma
// (yuqorida). Hammasi RLS bilan multi-tenant (migration.sql da policy
// qo'shiladi — Task 13).
// ============================================================================

model HrTaskTemplate {
  id                 String   @id @default(uuid()) @db.Uuid
  accountId          String   @map("account_id") @db.Uuid
  title              String   @db.VarChar(255)
  description        String?
  assignedEmployeeId String?  @map("assigned_employee_id") @db.Uuid
  assignedRole       String?  @map("assigned_role") @db.VarChar(50)
  department         String?  @db.VarChar(100)
  priority           String   @default("medium") @db.VarChar(20)
  triggerType        String   @map("trigger_type") @db.VarChar(20)
  scheduleConfig     Json?    @map("schedule_config")
  eventConfig        Json?    @map("event_config")
  responseType       String   @default("none") @map("response_type") @db.VarChar(20)
  deadlineMinutes    Int?     @map("deadline_minutes")
  rewardMinor        BigInt?  @map("reward_minor")
  fineMinor          BigInt?  @map("fine_minor")
  checkerId          String?  @map("checker_id") @db.Uuid
  dependsOnId        String?  @map("depends_on_id") @db.Uuid
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account          Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignedEmployee Employee?        @relation("HrTemplateAssignee", fields: [assignedEmployeeId], references: [id])
  checker          Employee?        @relation("HrTemplateChecker", fields: [checkerId], references: [id])
  dependsOn        HrTaskTemplate?  @relation("HrTemplateDeps", fields: [dependsOnId], references: [id])
  dependents       HrTaskTemplate[] @relation("HrTemplateDeps")
  logs             HrTaskLog[]
  taskInstances    Task[]

  @@index([accountId, isActive])
  @@index([accountId, triggerType])
  @@map("hr_task_template")
}

model HrTaskLog {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  templateId        String    @map("template_id") @db.Uuid
  taskId            String    @unique @map("task_id") @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  status            String    @db.VarChar(20)
  responseText      String?   @map("response_text")
  sentAt            DateTime  @map("sent_at") @db.Timestamptz()
  answeredAt        DateTime? @map("answered_at") @db.Timestamptz()
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewedById      String?   @map("reviewed_by_id") @db.Uuid
  reviewComment     String?   @map("review_comment")
  telegramMessageId String?   @map("telegram_message_id") @db.VarChar(50)
  failReason        String?   @map("fail_reason")

  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template   HrTaskTemplate   @relation(fields: [templateId], references: [id])
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee         @relation("HrTaskAssignee", fields: [employeeId], references: [id])
  reviewedBy Employee?        @relation("HrTaskChecker", fields: [reviewedById], references: [id])
  bonusFines HrBonusFineLog[]

  @@index([accountId, employeeId, status])
  @@index([accountId, templateId, sentAt(sort: Desc)])
  @@index([accountId, status, sentAt(sort: Desc)])
  @@map("hr_task_log")
}

model HrAttendance {
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  checkInTime  DateTime  @map("check_in_time") @db.Timestamptz()
  checkOutTime DateTime? @map("check_out_time") @db.Timestamptz()
  editedById   String?   @map("edited_by_id") @db.Uuid
  editedAt     DateTime? @map("edited_at") @db.Timestamptz()
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // === HR GPS-davomat (auto keldi/ketdi) — all nullable/defaulted, prod-safe ===
  checkInLat      Float?  @map("check_in_lat")
  checkInLng      Float?  @map("check_in_lng")
  checkInAccuracy Int?    @map("check_in_accuracy")
  checkOutLat     Float?  @map("check_out_lat")
  checkOutLng     Float?  @map("check_out_lng")
  source          String  @default("auto_gps") @map("source") @db.VarChar(12) // 'auto_gps' | 'manual'
  lateMinutes     Int     @default(0) @map("late_minutes")
  workLocationId  String? @map("work_location_id") @db.Uuid // raw FK, no relation (mirror Employee.groupId)
  autoClosed      Boolean @default(false) @map("auto_closed") // closed by nightly cron (departure not seen)

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee Employee  @relation("HrAttendanceEmployee", fields: [employeeId], references: [id])
  editedBy Employee? @relation("HrAttendanceEditor", fields: [editedById], references: [id])

  @@index([accountId, employeeId, checkInTime(sort: Desc)])
  @@map("hr_attendance")
}

