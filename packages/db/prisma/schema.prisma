  project             Project?             @relation("PrepaymentReturnProject", fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([accountId, name])
  @@index([accountId, prepaymentId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("prepayment_returns")
}

/// Internal order (Внутренний заказ) — request from one warehouse/dept to
/// another for stock to be delivered. Becomes a Move when fulfilled.
model InternalOrder {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  organizationId String  @map("organization_id") @db.Uuid
  storeId        String  @map("store_id") @db.Uuid
  // moysklad parity — Проект (internal stock doc: no counterparty → no Договор).
  projectId      String? @map("project_id") @db.Uuid

  moment                DateTime  @default(now()) @db.Timestamptz()
  deliveryPlannedMoment DateTime? @map("delivery_planned_moment") @db.Timestamptz()
  applicable            Boolean   @default(false)
  state                 String    @default("draft") @db.VarChar(30)
  postedAt              DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor      BigInt @default(0) @map("sum_minor")
  vatSumMinor   BigInt @default(0) @map("vat_sum_minor")
  movedSumMinor BigInt @default(0) @map("moved_sum_minor")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

