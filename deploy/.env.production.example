# ─────────────────────────────────────────────────────────────────────
# Sherset — PRODUCTION environment template (sherset.biznesjon.uz)
#
# Copy to the shared secret file on the VPS and fill the real values:
#     cp deploy/.env.production.example /var/www/sherset/.env
#     # edit /var/www/sherset/.env  → real DB url + strong random secrets
#
# Then symlink it into each app dir so dotenv picks it up:
#     ln -sf /var/www/sherset/.env /var/www/sherset/apps/api/.env
#     ln -sf /var/www/sherset/.env /var/www/sherset/apps/web/.env
#     ln -sf /var/www/sherset/.env /var/www/sherset/packages/db/.env
#
# ⚠️ NEVER commit the filled-in .env — it holds live secrets.
#    Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────

# --- Runtime ---
NODE_ENV=production
TZ=Asia/Tashkent

# --- API (NestJS) ---
# API_PORT must match the nginx `sherset_api` upstream + the ecosystem
# api env. Bind port is loopback-only via PM2 → nginx fronts it.
API_PORT=4000

# --- Database (PostgreSQL) ---
# SHADOW_DATABASE_URL is only needed for `prisma migrate dev`; production
# uses `prisma migrate deploy` which does not require the shadow DB, but
# keep it here if you run migrations from this host.
DATABASE_URL=postgresql://sherset:CHANGE_ME@127.0.0.1:5432/sherset?schema=public
SHADOW_DATABASE_URL=postgresql://sherset:CHANGE_ME@127.0.0.1:5432/sherset_shadow?schema=public

# --- Auth / crypto (generate each with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=CHANGE_ME_32_char_random_hex
JWT_REFRESH_SECRET=CHANGE_ME_32_char_random_hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_HASH_ROUNDS=12
COOKIE_SECRET=CHANGE_ME_random_string
HR_SESSION_KEY=CHANGE_ME_random_string

# --- CORS ---
# Comma-separated list of allowed browser origins. For a single domain
# this is just the HTTPS site. localhost is always allowed (dev).
WEB_ORIGIN=https://sherset.biznesjon.uz

# --- Web (Next.js) ---
# API_ORIGIN is where the Next server proxies /api/* internally. Point it
# at the loopback API port (NOT the public domain) to skip a round-trip
# through nginx. Must match API_PORT above.
API_ORIGIN=http://127.0.0.1:4000
# NEXT_PUBLIC_* values are baked in at BUILD time — set before `pnpm build:web`.
NEXT_PUBLIC_APP_URL=https://sherset.biznesjon.uz

# --- External / integrations ---
CBRU_API_BASE=https://cbu.uz/ru/arkhiv-kursov-valyut/json
MOYSKLAD_TOKEN=

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=false
