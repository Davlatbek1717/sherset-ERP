<?xml version="1.0" encoding="utf-8"?>
<!--
  🔴 TEGISH NISHONLARI (G5, 4-vazifa).

  Reja aytadi: «katta tegish nishonlari ANIQ pikselda (`min-h-[44px]` va
  yirikroq) — dizayn-tizim `rem` bazasi 12px ekanini yodda tut». Web tomonda
  bu tuzoq: `min-h-11` = 2.75rem = 33px (44px EMAS), chunki baza 16px emas.

  Android da `rem` yo'q, shuning uchun bu yerda o'lchov `dp` da va ATAYLAB
  web minimumidan yirikroq: omborchi qo'lqopda, harakatda va sovuq omborda
  ishlaydi. Material minimumi 48dp; biz 56dp dan boshlaymiz.
-->
<resources>
    <dimen name="touch_target_min">56dp</dimen>
    <dimen name="touch_target_primary">64dp</dimen>
    <dimen name="text_body">18sp</dimen>
    <dimen name="text_code">22sp</dimen>
    <dimen name="gap">12dp</dimen>
</resources>
