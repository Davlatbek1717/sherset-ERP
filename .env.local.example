# Moysklad audit reference capture — Audit Protocol v2.1 Phase 0
#
# Bu env var'lar `scripts/capture-moysklad-references.ts` script uchun
# kerak — moysklad.uz'ga avtomat kirib har sahifaning kerakli holatlarini
# screenshot qiladi (default / dropdown ochilgan / row selected / etc.).
#
# Foydalanish:
#   cp .env.local.example .env.local
#   # .env.local'ni o'zingizning real moysklad credentials bilan to'ldiring
#   pnpm capture-moysklad purchase-orders
#
# .env.local git'ga commit qilinmaydi (`.gitignore`'da bor).

MOYSKLAD_URL="https://app.moysklad.uz"
MOYSKLAD_EMAIL="your-email@example.com"
MOYSKLAD_PASSWORD="your-password"
