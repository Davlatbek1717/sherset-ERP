{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "incremental": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@moysklad/ui": ["../../packages/design-system/src/index.ts"],
      "@moysklad/ui/*": ["../../packages/design-system/src/*"],
      "@moysklad/money": ["../../packages/money/dist/index.js"],
      "@moysklad/money/*": ["../../packages/money/dist/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-linkcert/types/**/*.ts",
    ".next-spot/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-provverify/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
