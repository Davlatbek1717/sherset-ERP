NODE_ENV=development
TZ=Asia/Tashkent
API_PORT=4000
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5433/moysklad_dev?schema=public
JWT_ACCESS_SECRET=replace-with-32-char-random-string
JWT_REFRESH_SECRET=replace-with-32-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_HASH_ROUNDS=4
COOKIE_SECRET=replace-with-random-string
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
LOG_PRETTY=true
CBRU_API_BASE=https://cbu.uz/ru/arkhiv-kursov-valyut/json
MOYSKLAD_TOKEN=

# === HR Module ===
# 32-byte AES-256-GCM key for Telegram MTProto session encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED in production. Without this, MTProto session storage will fail.
HR_SESSION_KEY=

# === Kassa PIN-kirishi (kassa .exe) ===
# `employees.pos_pin_lookup` uchun HMAC-SHA256 pepper. PIN bo'yicha xodimni
# TOPISH shu qiymatga bog'liq (argon2 xeshi tuzli — qidirib bo'lmaydi).
# Generatsiya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 🔴 PRODUCTION'DA MAJBURIY — yo'q bo'lsa API BOOT'DA yiqiladi (ataylab: jim
# dev-fallback bilan ishlash keyin hamma PIN'ni yaroqsiz qilardi).
# 🔴 O'ZGARTIRMANG: qiymat o'zgarsa hamma POS PIN yaroqsiz bo'ladi va PIN'lar
# qayta berilishi kerak (PIN saqlanmaydi, qayta hisoblab bo'lmaydi).
POS_PIN_PEPPER=replace-with-32-byte-hex-random-string

# === Mijozga qarz/to'lov Telegram xabari (counterparty-debt-notify) ===
# Qarzga savdo, qarz to'lovi va tuzatish (qaytarish/bekor) hodisalarida
# EGAGA (Bot API guruhi) va MIJOZGA (admin MTProto sloti orqali shaxsiy
# chatiga) xabar yuboriladi.
#
# 🔴 KILL-SWITCH: `true` bo'lmaguncha MIJOZGA HECH QANDAY xabar ketmaydi.
# 2026-07-23/07-26 qarorlari bilan o'chirilgan edi; 2026-08-16 da egasi
# qayta yoqishni so'radi. Yoqishdan OLDIN bitta sinov mijozida tekshiring.
DEBT_NOTIFY_ENABLED=false
# Egaga xabar boradigan bot va guruh (bo'sh ⇒ ega tomoni jim, mijoz tomoni ishlaydi).
DEBT_NOTIFY_BOT_TOKEN=
DEBT_NOTIFY_CHAT_ID=
# Ega xabariga ⚠️ ogohlantirish qatori qo'shiladigan qarz chegarasi (tiyin).
# Bo'sh ⇒ ogohlantirish yo'q; xabarni HECH QACHON to'smaydi.
DEBT_NOTIFY_THRESHOLD_MINOR=
# 🔴 BIRINCHI TO'LQIN QULFI (sukut: yoqilgan). Faqat `attributes.tgid` yoki
# bog'langan Telegram chati bor mijozlarga yoziladi. Xabar egasining SHAXSIY
# raqamidan ketgani uchun, hech qachon o'zi yozmagan odamga yozish «Report
# spam» xavfini tug'diradi — buni MTProto FLOOD_WAIT himoyasi QOPLAMAYDI.
# `false` = telefoni bor HAR QANDAY mijozga yoziladi (xavfni bilib qo'ying).
DEBT_NOTIFY_ONLY_KNOWN_CONTACTS=true
# 🔴 OMMAVIY PORTLASH QULFI: daqiqasiga maksimal mijoz xabari. Balansni
# ommaviy qayta hisoblaydigan skript ishga tushsa, usiz yuzlab mijozga bir
# zumda xabar ketardi. 0 yoki noto'g'ri qiymat ⇒ qulf o'chadi.
DEBT_NOTIFY_MAX_PER_MINUTE=20
