# --- Environment ---
NODE_ENV=development
TZ=Asia/Tashkent

# --- API (NestJS) ---
API_PORT=4000
API_BASE_URL=http://localhost:4000

# --- Web app (Next.js) ---
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Marketing (Next.js SSG) ---
MARKETING_PORT=3001
MARKETING_BASE_URL=http://localhost:3001

# --- Database (PostgreSQL 16, native install) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moysklad_dev?schema=public

# --- Cache / Queue (Redis 7 — Memurai on Windows) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO local) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=moysklad-dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- SMTP (Mailhog for dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Moysklad Clone <noreply@moysklad-clone.local>"

# --- Auth ---
JWT_ACCESS_SECRET=change-me-in-real-env-min-32-chars
JWT_REFRESH_SECRET=change-me-in-real-env-min-32-chars-different
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_HASH_ROUNDS=12

# --- Feature flags ---
FEATURE_WIZARD_ONBOARDING=true
FEATURE_MARKING_ASL=true
FEATURE_SOLIQ_UZ=true

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=debug
LOG_PRETTY=true

# --- UZ integratsiyalar (Sprint 5+) ---
SOLIQ_UZ_API_BASE=
SOLIQ_UZ_API_KEY=
ASL_BELGISI_API_BASE=
ASL_BELGISI_API_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
ESKIZ_EMAIL=
ESKIZ_SECRET=
CBRU_API_BASE=https://cbu.uz/ru/arkhiv-kursov-valyut/json
