/moysklad-login.yml

# Runtime artifacts from the dev launch scripts
*.err
.commit-msg.txt
.api-dev.log
.web-dev.log

tools/scripts/.api-token
docs/moysklad-reference/_api-real/

# Moysklad audit reference screenshots — captured by
# `pnpm capture-moysklad` (Audit Protocol v2.1). PNG'lar git'ga
# olinmaydi (size + copyright); metadata.json (DOM dumps, dropdown
# items, column gear items) commit qilinadi va PR'da review uchun.
docs/moysklad-reference/**/states/*.png
# Detail/edit-form captures (`--detail`): same policy — PNG'lar git'ga olinmaydi,
# *.html DOM dump'lar + detail-metadata.json (dropdown items) commit qilinadi.
docs/moysklad-reference/**/detail/*.png
!docs/moysklad-reference/**/metadata.json
!docs/moysklad-reference/**/detail-metadata.json

# Migration script ID-map (real-account UUIDs → test-account UUIDs)
.migration-id-map.json

# Drag-and-drop screenshots
image*.png

# Playwright saqlangan moysklad sessiyasi (hech qachon commit qilinmaydi)
.auth/

# Throwaway research/analysis notes (session-start audit flagged as workspace noise)
scratch/

# local list-audit loop logs
scripts/.loop-logs/

# Live moysklad deep-spec captures (real account data: names/phones) — NEVER commit
moysklad-co-new-*.png
moysklad-co-new-*.yml
moysklad-co-new-*.json
moysklad-co-new-*.txt

# Local app self-verify screenshots — never commit
ours-co-new-*.png
ours-*.png
verify-*.png
# Live moysklad captures (contain real account names/phones) — never commit
moysklad-*.png
ms-*.png
